# Salin ke .env lalu sesuaikan. JANGAN commit .env.
APP_ENV=development            # development | test | production
PORT=3000
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info                 # debug | info | warn | error
TRUST_PROXY=false              # true bila di belakang tunnel/reverse proxy HTTPS
TAMPILKAN_NILAI_SISWA=false    # D-017

DB_HOST=127.0.0.1
DB_PORT=3306
# Opsional: UNIX socket (Fedora: /var/lib/mysql/mysql.sock). Jika diisi, DB_HOST/DB_PORT diabaikan.
# DB_SOCKET=/var/lib/mysql/mysql.sock
DB_USER=root
DB_PASSWORD=
DB_NAME=cbt_sekolah_go         # DB uji: cbt_sekolah_go_test
DB_MAX_OPEN_CONNS=25
