<!DOCTYPE html>
<html lang="id">
<head>{{template "app_head" "Ujian Susulan"}}</head>
<body class="bg-light">
{{template "admin_navbar" .}}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="page-title mb-1"><i class="bi bi-calendar2-plus text-primary me-2"></i>Ujian Susulan</h3>
            <p class="text-muted mb-0">Beri izin siswa tertentu masuk di luar jadwal ujian (sakit, kendala teknis). Siswa lain tetap mengikuti jadwal.</p>
        </div>
    </div>

    {{template "app_flash" .}}

    <form method="GET" action="/admin/susulan" class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <select name="ujian_id" class="form-select form-select-sm" aria-label="Pilih ujian" onchange="this.form.submit()">
                {{range .UjianList}}
                <option value="{{.ID}}" {{if eq .ID $.UjianID}}selected{{end}}>{{.NamaUjian}} — {{.NamaKelas}} ({{.TanggalMulai.Format "02 Jan 2006 15:04"}})</option>
                {{else}}
                <option value="">Belum ada ujian</option>
                {{end}}
            </select>
        </div>
    </form>

    {{if .Ujian}}
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white small text-muted">
            Kelas {{.Ujian.NamaKelas}} · durasi {{.Ujian.Durasi}} menit · jadwal berakhir {{.Ujian.TanggalSelesai.Format "02 Jan 2006 15:04"}}
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width:50px">No</th>
                        <th>NIS</th>
                        <th>Nama</th>
                        <th>Status</th>
                        <th>Izin susulan</th>
                        <th class="text-end" style="min-width:320px">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    {{range $i, $b := .Baris}}
                    <tr>
                        <td class="text-center text-muted">{{add $i 1}}</td>
                        <td>{{$b.NIS}}</td>
                        <td>{{$b.Nama}}</td>
                        <td>
                            {{if $b.SudahNilai}}<span class="badge bg-success-subtle text-success-emphasis">Selesai</span>
                            {{else if eq $b.StatusSesi "sedang_ujian"}}<span class="badge bg-primary-subtle text-primary-emphasis">Sedang ujian</span>
                            {{else if eq $b.StatusSesi "keluar_paksa"}}<span class="badge bg-danger-subtle text-danger-emphasis">Terkunci</span>
                            {{else}}<span class="badge bg-secondary-subtle text-secondary-emphasis">Belum masuk</span>{{end}}
                        </td>
                        <td class="small">
                            {{if $b.IzinSampai}}Sampai <strong>{{$b.IzinSampai.Format "02 Jan 2006 15:04"}}</strong>{{if $b.Alasan}}<div class="text-muted">{{$b.Alasan}}</div>{{end}}{{else}}<span class="text-muted">-</span>{{end}}
                        </td>
                        <td class="text-end">
                            {{if $b.SudahNilai}}
                                <span class="text-muted small">Sudah bernilai</span>
                            {{else}}
                            <form method="POST" action="/admin/susulan/tambah" class="d-inline-flex flex-wrap gap-1 justify-content-end">
                                <input type="hidden" name="ujian_id" value="{{$.UjianID}}">
                                <input type="hidden" name="siswa_id" value="{{$b.SiswaID}}">
                                <input type="datetime-local" name="sampai" class="form-control form-control-sm" style="width:12.5rem" aria-label="Berlaku sampai (kosong = durasi + 30 menit)">
                                <input type="text" name="alasan" class="form-control form-control-sm" style="width:9rem" maxlength="255" placeholder="Alasan" aria-label="Alasan">
                                <button type="submit" class="btn btn-sm btn-primary">{{if $b.IzinSampai}}Perbarui{{else}}Beri izin{{end}}</button>
                            </form>
                            {{if $b.IzinID}}
                            <form method="POST" action="/admin/susulan/hapus/{{$b.IzinID}}" class="d-inline" data-confirm="Cabut izin susulan {{$b.Nama}}?">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Cabut izin"><i class="bi bi-x-lg"></i></button>
                            </form>
                            {{end}}
                            {{end}}
                        </td>
                    </tr>
                    {{else}}
                    <tr><td colspan="6" class="text-center py-4 text-muted">Tidak ada siswa pada kelas ini.</td></tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white small text-muted">
            Kosongkan batas waktu untuk memakai durasi ujian + 30 menit dari sekarang. Siswa yang sudah bernilai tidak dapat diberi izin; gunakan Reset ujian bila perlu mengulang.
        </div>
    </div>
    {{end}}
</div>

{{template "app_scripts"}}
</body>
</html>
