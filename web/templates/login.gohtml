<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Ujian CBT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon.png">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/images/favicon.png">
    <style>
        :root {
            --primary: #3b5bdb;
            --primary-light: #eef2ff;
            --success: #0ca678;
            --bg: #f0f2f8;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .login-wrapper {
            width: 100%;
            max-width: 420px;
        }
        .login-brand {
            text-align: center;
            margin-bottom: 2rem;
        }
        .login-brand img {
            width: 64px; height: 64px;
            object-fit: contain;
            margin-bottom: .75rem;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,.12));
        }
        .login-brand h1 {
            font-family: 'Sora', sans-serif;
            font-size: 1.35rem;
            font-weight: 800;
            color: #1e2022;
            letter-spacing: -.03em;
        }
        .login-brand p {
            font-size: .82rem;
            color: #74788d;
            margin-top: .25rem;
        }
        .login-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 4px 24px rgba(0,0,0,.10);
            overflow: hidden;
        }
        .login-card-header {
            background: linear-gradient(135deg, var(--primary), #4c6ef5);
            padding: 1.25rem 1.75rem;
            display: flex;
            align-items: center;
            gap: .65rem;
        }
        .login-card-header i {
            font-size: 1.25rem;
            color: rgba(255,255,255,.85);
        }
        .login-card-header h2 {
            font-family: 'Sora', sans-serif;
            font-size: .95rem;
            font-weight: 700;
            color: #fff;
            margin: 0;
        }
        .login-card-body { padding: 1.75rem; }
        .alert-custom {
            background: #fff0f0;
            border-left: 4px solid #e03131;
            border-radius: 8px;
            padding: .7rem 1rem;
            font-size: .85rem;
            color: #c92a2a;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: .5rem;
        }
        .form-group { margin-bottom: 1rem; }
        .form-label {
            font-size: .78rem;
            font-weight: 600;
            color: #74788d;
            letter-spacing: .02em;
            display: block;
            margin-bottom: .35rem;
        }
        .input-wrap { position: relative; }
        .input-wrap i {
            position: absolute;
            left: .85rem;
            top: 50%;
            transform: translateY(-50%);
            color: #adb5bd;
            font-size: .95rem;
            pointer-events: none;
        }
        .form-control, .form-select {
            width: 100%;
            border: 1.5px solid #e2e5ec;
            border-radius: 8px;
            font-family: 'DM Sans', sans-serif;
            font-size: .875rem;
            padding: .6rem .85rem .6rem 2.4rem;
            transition: all .2s;
            background: #fafbff;
            color: #2d3142;
        }
        .form-select { padding-left: 2.4rem; }
        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59,91,219,.12);
            outline: none;
            background: #fff;
        }
        .btn-login {
            width: 100%;
            background: linear-gradient(135deg, var(--primary), #4c6ef5);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: .7rem 1rem;
            font-family: 'Sora', sans-serif;
            font-size: .9rem;
            font-weight: 700;
            cursor: pointer;
            transition: all .22s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            margin-top: 1.25rem;
        }
        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(59,91,219,.35);
        }
        .btn-login:active { transform: translateY(0); }
        .login-links {
            text-align: center;
            margin-top: 1.5rem;
            font-size: .78rem;
            color: #74788d;
        }
        .login-links a {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
        }
        .login-links a:hover { text-decoration: underline; }
        .login-links .divider { margin: 0 .5rem; color: #dee2e6; }

        @media (max-width: 480px) {
            .login-card-body { padding: 1.25rem; }
            .login-brand h1 { font-size: 1.15rem; }
        }
    </style>
</head>
<body>
<div class="login-wrapper">
    <div class="login-brand">
        <img src="/images/logo-sekolah.png" alt="Logo Sekolah"
             onerror="this.style.display='none'">
        <h1>CBT MTs. AL-IHSAN BATUJAJAR</h1>
        <p>Computer Based Test — Portal Siswa</p>
    </div>

    <div class="login-card">
        <div class="login-card-header">
            <i class="bi bi-laptop"></i>
            <h2>Login Ujian</h2>
        </div>
        <div class="login-card-body">
            {{ if .Error }}
            <div class="alert-custom">
                <i class="bi bi-exclamation-circle-fill"></i>
                {{ .Error }}
            </div>
            {{ end }}

            <form action="/login-siswa" method="POST">
                <div class="form-group">
                    <label class="form-label">NIS (Nomor Induk Siswa)</label>
                    <div class="input-wrap">
                        <i class="bi bi-person"></i>
                        <input type="text" name="nis" class="form-control"
                               placeholder="Masukkan NIS Anda" required autocomplete="off">
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">PIN Ujian</label>
                    <div class="input-wrap">
                        <i class="bi bi-key"></i>
                        <input type="password" name="pin" class="form-control"
                               placeholder="Masukkan PIN ujian" required>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Pilih Ujian</label>
                    <div class="input-wrap">
                        <i class="bi bi-journal-check"></i>
                        <select name="ujian_id" id="ujian_id" class="form-select" required>
                            <option value="">-- Memuat daftar ujian... --</option>
                        </select>
                    </div>
                </div>

                <div class="form-group" id="group-token" style="display: none;">
                    <label class="form-label">Token Ujian <span class="text-danger">*</span></label>
                    <div class="input-wrap">
                        <i class="bi bi-shield-lock"></i>
                        <input type="text" name="token_ujian" id="token_ujian" class="form-control"
                               placeholder="Masukkan token dari pengawas" autocomplete="off" style="text-transform: uppercase;">
                    </div>
                </div>

                <input type="hidden" name="device_type" id="device_type" value="laptop">

                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Mulai Ujian
                </button>
            </form>
        </div>
    </div>

    <div class="login-links">
        <a href="/login-guru"><i class="bi bi-person-badge"></i> Login Guru</a>
        <span class="divider">|</span>
        <a href="/login-admin"><i class="bi bi-shield-lock"></i> Login Admin</a>
    </div>
</div>
<script>
    let daftarUjianCache = [];

    fetch('/api/daftar-ujian')
        .then(res => res.json())
        .then(data => {
            daftarUjianCache = data;
            const select = document.getElementById('ujian_id');
            if (data.length === 0) {
                select.innerHTML = '<option value="">-- Tidak ada ujian aktif --</option>';
                return;
            }
            select.innerHTML = '<option value="">-- Pilih Ujian --</option>';
            data.forEach(ujian => {
                const label = ujian.nama_kelas ? `${ujian.nama_ujian} (${ujian.nama_kelas})` : ujian.nama_ujian;
                select.innerHTML += `<option value="${ujian.id}">${label}</option>`;
            });
        })
        .catch(() => {
            document.getElementById('ujian_id').innerHTML =
                '<option value="">-- Gagal memuat ujian --</option>';
        });

    const selectUjian = document.getElementById('ujian_id');
    const groupToken = document.getElementById('group-token');
    const inputToken = document.getElementById('token_ujian');

    selectUjian.addEventListener('change', () => {
        const selectedId = parseInt(selectUjian.value, 10);
        const ujian = daftarUjianCache.find(u => u.id === selectedId);
        if (ujian && ujian.butuh_token) {
            groupToken.style.display = 'block';
            inputToken.required = true;
        } else {
            groupToken.style.display = 'none';
            inputToken.required = false;
            inputToken.value = '';
        }
    });

    (function detectDeviceType() {
        const hasFinePointer = window.matchMedia && window.matchMedia('(pointer: fine)').matches;
        const isWideScreen = (window.innerWidth || screen.width) >= 1024;
        const deviceType = (hasFinePointer && isWideScreen) ? 'laptop' : 'hp';
        const inputDevice = document.getElementById('device_type');
        if (inputDevice) {
            inputDevice.value = deviceType;
        }
    })();
</script>
</body>
</html>

