<!DOCTYPE html>
<html lang="id">
<head>{{template "app_head" "Dashboard"}}</head>
<body class="bg-light">
{{template "admin_navbar" .}}

<div class="container py-4">
    <div class="mb-4">
        <h3 class="page-title mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard</h3>
        <p class="text-muted mb-0">Ringkasan data dan ujian yang sedang/akan berlangsung.</p>
    </div>

    {{template "app_flash" .}}

    {{with .Ringkasan}}
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a href="/admin/monitor" class="card border-0 shadow-sm text-decoration-none h-100">
                <div class="card-body">
                    <div class="small text-muted fw-semibold text-uppercase">Ujian berlangsung</div>
                    <div class="fs-2 fw-bold text-success">{{.UjianAktif}}</div>
                    <div class="small text-muted">{{.SesiAktif}} siswa sedang mengerjakan</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/admin/ujian" class="card border-0 shadow-sm text-decoration-none h-100">
                <div class="card-body">
                    <div class="small text-muted fw-semibold text-uppercase">Total ujian</div>
                    <div class="fs-2 fw-bold text-dark">{{.Ujian}}</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/admin/siswa" class="card border-0 shadow-sm text-decoration-none h-100">
                <div class="card-body">
                    <div class="small text-muted fw-semibold text-uppercase">Siswa</div>
                    <div class="fs-2 fw-bold text-dark">{{.Siswa}}</div>
                    <div class="small text-muted">{{.Kelas}} kelas</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/admin/guru" class="card border-0 shadow-sm text-decoration-none h-100">
                <div class="card-body">
                    <div class="small text-muted fw-semibold text-uppercase">Guru</div>
                    <div class="fs-2 fw-bold text-dark">{{.Guru}}</div>
                    <div class="small text-muted">{{.Mapel}} mata pelajaran</div>
                </div>
            </a>
        </div>
    </div>
    {{end}}

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold"><i class="bi bi-calendar-event me-2"></i>Ujian berlangsung &amp; akan datang</div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ujian</th>
                        <th>Kelas</th>
                        <th>Jadwal</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Mengerjakan / Selesai</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .UjianList}}
                    <tr>
                        <td><div class="fw-semibold">{{.NamaUjian}}</div><div class="small text-muted">{{.NamaMapel}}</div></td>
                        <td><span class="badge bg-secondary">{{.NamaKelas}}</span></td>
                        <td class="small">{{.TanggalMulai.Format "02/01/2006 15:04"}}<br>s.d. {{.TanggalSelesai.Format "02/01/2006 15:04"}}</td>
                        <td class="text-center">
                            {{if .Berlangsung}}<span class="badge bg-success">Berlangsung</span>{{else}}<span class="badge bg-info text-dark">Akan datang</span>{{end}}
                        </td>
                        <td class="text-center">{{.SedangUjian}} / {{.Selesai}}</td>
                        <td class="text-end text-nowrap">
                            <a href="/admin/monitor/{{.ID}}" class="btn btn-sm btn-primary"><i class="bi bi-display"></i> Monitor</a>
                            <a href="/admin/soal?ujian_id={{.ID}}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-question-square"></i> Soal</a>
                        </td>
                    </tr>
                    {{else}}
                    <tr><td colspan="6" class="text-center text-muted py-4">Tidak ada ujian yang sedang atau akan berlangsung.</td></tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>

{{template "app_scripts"}}
</body>
</html>
