<!DOCTYPE html>
<html lang="id">
<head>{{template "app_head" "Dashboard"}}</head>
<body class="bg-light">
{{template "admin_navbar" .}}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="page-title mb-1" style="font-family:'Sora',sans-serif;font-weight:700;"><i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard</h3>
            <p class="text-muted mb-0 small">Ringkasan status sistem dan jadwal ujian aktif CBT MTs Al-Ihsan Batujajar.</p>
        </div>
        <a href="/admin/ujian" class="btn btn-primary" style="border-radius:12px;padding:10px 20px;font-weight:600;">
            <i class="bi bi-plus-lg me-1"></i> Ujian baru
        </a>
    </div>

    {{template "app_flash" .}}

    {{with .Ringkasan}}
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a href="/admin/monitor" class="card border-0 shadow-sm text-decoration-none h-100" style="border-radius:16px;border:1px solid #dfe3ee !important;transition:transform .18s;">
                <div class="card-body p-3 p-xl-4">
                    <div class="small fw-semibold text-uppercase" style="color:#5b6280;">Ujian berlangsung</div>
                    <div style="font-family:'Sora',sans-serif;font-weight:700;font-size:32px;color:#0b8a68;line-height:1.2;margin:4px 0;">{{.UjianAktif}}</div>
                    <div class="small text-muted">{{.SesiAktif}} siswa sedang mengerjakan</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/admin/ujian" class="card border-0 shadow-sm text-decoration-none h-100" style="border-radius:16px;border:1px solid #dfe3ee !important;transition:transform .18s;">
                <div class="card-body p-3 p-xl-4">
                    <div class="small fw-semibold text-uppercase" style="color:#5b6280;">Total ujian</div>
                    <div style="font-family:'Sora',sans-serif;font-weight:700;font-size:32px;color:#1b2038;line-height:1.2;margin:4px 0;">{{.Ujian}}</div>
                    <div class="small text-muted">Jadwal terdaftar</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/admin/siswa" class="card border-0 shadow-sm text-decoration-none h-100" style="border-radius:16px;border:1px solid #dfe3ee !important;transition:transform .18s;">
                <div class="card-body p-3 p-xl-4">
                    <div class="small fw-semibold text-uppercase" style="color:#5b6280;">Siswa</div>
                    <div style="font-family:'Sora',sans-serif;font-weight:700;font-size:32px;color:#3b5bdb;line-height:1.2;margin:4px 0;">{{.Siswa}}</div>
                    <div class="small text-muted">{{.Kelas}} kelas</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/admin/guru" class="card border-0 shadow-sm text-decoration-none h-100" style="border-radius:16px;border:1px solid #dfe3ee !important;transition:transform .18s;">
                <div class="card-body p-3 p-xl-4">
                    <div class="small fw-semibold text-uppercase" style="color:#5b6280;">Guru</div>
                    <div style="font-family:'Sora',sans-serif;font-weight:700;font-size:32px;color:#1b2038;line-height:1.2;margin:4px 0;">{{.Guru}}</div>
                    <div class="small text-muted">{{.Mapel}} mata pelajaran</div>
                </div>
            </a>
        </div>
    </div>
    {{end}}

    <div class="card border-0 shadow-sm" style="border-radius:16px;overflow:hidden;border:1px solid #dfe3ee !important;">
        <div class="card-header bg-white py-3 px-4 border-bottom fw-semibold" style="font-family:'Sora',sans-serif;font-size:16px;">
            <i class="bi bi-calendar-event text-primary me-2"></i>Ujian Berlangsung &amp; Akan Datang
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="font-size:14px;">
                <thead style="background:#fafbfe;color:#5b6280;font-size:12px;text-transform:uppercase;letter-spacing:0.04em;">
                    <tr>
                        <th class="px-4 py-3">Ujian</th>
                        <th class="py-3">Kelas</th>
                        <th class="py-3">Jadwal</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="py-3 text-center">Mengerjakan / Selesai</th>
                        <th class="px-4 py-3 text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .UjianList}}
                    <tr style="vertical-align:middle;">
                        <td class="px-4"><div class="fw-semibold" style="color:#1b2038;">{{.NamaUjian}}</div><div class="small text-muted">{{.NamaMapel}}</div></td>
                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis" style="border-radius:8px;padding:4px 10px;">{{.NamaKelas}}</span></td>
                        <td class="small text-muted">{{.TanggalMulai.Format "02/01/2006 15:04"}}<br>s.d. {{.TanggalSelesai.Format "02/01/2006 15:04"}}</td>
                        <td class="text-center">
                            {{if .Berlangsung}}
                            <span class="badge" style="background:#dcf5ec;color:#0b8a68;font-weight:600;padding:6px 12px;border-radius:999px;">Berlangsung</span>
                            {{else}}
                            <span class="badge" style="background:#eef2ff;color:#3b5bdb;font-weight:600;padding:6px 12px;border-radius:999px;">Akan datang</span>
                            {{end}}
                        </td>
                        <td class="text-center fw-semibold" style="font-variant-numeric:tabular-nums;">{{.SedangUjian}} / {{.Selesai}}</td>
                        <td class="px-4 text-end text-nowrap">
                            <a href="/admin/monitor/{{.ID}}" class="btn btn-sm" style="background:#eef2ff;color:#2b44b0;border-radius:10px;font-weight:600;padding:6px 14px;"><i class="bi bi-display me-1"></i> Monitor</a>
                            <a href="/admin/soal?ujian_id={{.ID}}" class="btn btn-sm btn-outline-secondary" style="border-radius:10px;padding:6px 12px;"><i class="bi bi-question-square"></i></a>
                        </td>
                    </tr>
                    {{else}}
                    <tr><td colspan="6" class="text-center text-muted py-5">Tidak ada ujian yang sedang atau akan berlangsung.</td></tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>

{{template "app_scripts"}}
</body>
</html>
