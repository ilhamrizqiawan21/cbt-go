{{/*
  Partial bersama halaman admin & guru. Pemakaian:
    <head>{{template "app_head" "Judul Halaman"}}</head>
    {{template "admin_navbar" .}} {{template "app_flash" .}} ... {{template "app_scripts"}}
*/}}
{{define "app_head"}}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.}} — CBT MTs Al-Ihsan</title>
    <link href="/css/vendor/bootstrap.min.css" rel="stylesheet">
    <link href="/css/vendor/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <style>
        .page-title { font-weight: 700; }
        .table td, .table th { vertical-align: middle; }
        .btn-icon { min-width: 2.25rem; }
        .ar { font-family: 'Amiri', serif; font-size: 1.15em; }
        @media (max-width: 575.98px) { .page-actions { width: 100%; } .page-actions > * { flex: 1 1 auto; } }
    </style>
{{end}}

{{define "app_flash"}}
    {{if .Error}}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>{{.Error}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button>
    </div>
    {{end}}
    {{if .Success}}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>{{.Success}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Tutup"></button>
    </div>
    {{end}}
{{end}}

{{define "app_scripts"}}
<script src="/js/vendor/bootstrap.bundle.min.js"></script>
<script>
    // Konfirmasi aksi berbahaya lewat atribut data-confirm pada <form> atau <a>.
    // Teks konfirmasi diletakkan di atribut HTML (di-escape html/template), bukan di string JS inline.
    document.addEventListener('submit', (e) => {
        const msg = e.target.getAttribute && e.target.getAttribute('data-confirm');
        if (msg && !window.confirm(msg)) e.preventDefault();
    }, true);
    document.addEventListener('click', (e) => {
        const a = e.target.closest && e.target.closest('a[data-confirm]');
        if (a && !window.confirm(a.getAttribute('data-confirm'))) e.preventDefault();
    }, true);
</script>
{{end}}

{{/* Label jenis log_kecurangan untuk ditampilkan. */}}
{{define "label_jenis"}}{{if eq . "pindah_tab"}}Pindah tab{{else if eq . "keluar_fullscreen"}}Keluar layar penuh{{else if eq . "copy_paste"}}Copy-paste{{else if eq . "ambil_alih_sesi"}}Ambil alih sesi{{else if eq . "buka_kunci"}}Buka kunci (admin){{else}}{{.}}{{end}}{{end}}
