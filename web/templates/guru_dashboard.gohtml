<!DOCTYPE html>
<html lang="id">
<head>{{template "app_head" "Dashboard Guru"}}</head>
<body class="bg-light">
{{template "guru_navbar" .}}

<div class="container py-4">
    <div class="mb-4">
        <h3 class="page-title mb-1">Assalamu'alaikum{{if .NamaGuru}}, {{.NamaGuru}}{{end}}</h3>
        <p class="text-muted mb-0">Ujian pada pengajaran Anda. Soal dikelola per ujian; essay dinilai setelah siswa selesai.</p>
    </div>

    {{template "app_flash" .}}

    {{if gt .TotalMenunggu 0}}
    <div class="alert alert-warning d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span><i class="bi bi-hourglass-split me-1"></i> <strong>{{.TotalMenunggu}}</strong> nilai siswa menunggu koreksi essay.</span>
        <a href="/guru/essay" class="btn btn-sm btn-warning">Nilai sekarang</a>
    </div>
    {{end}}

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ujian</th>
                        <th>Kelas</th>
                        <th>Jadwal</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Soal</th>
                        <th class="text-center">Selesai</th>
                        <th class="text-center">Menunggu essay</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .UjianList}}
                    <tr>
                        <td><div class="fw-semibold">{{.NamaUjian}}</div><div class="small text-muted">{{.NamaMapel}}</div></td>
                        <td><span class="badge bg-secondary">{{.NamaKelas}}</span></td>
                        <td class="small text-nowrap">{{.TanggalMulai.Format "02/01/2006 15:04"}}<br>s.d. {{.TanggalSelesai.Format "02/01/2006 15:04"}}</td>
                        <td class="text-center">
                            {{if .Berlangsung}}<span class="badge bg-success">Berlangsung</span>
                            {{else if .Berakhir}}<span class="badge bg-secondary">Berakhir</span>
                            {{else}}<span class="badge bg-info text-dark">Akan datang</span>{{end}}
                        </td>
                        <td class="text-center">{{.JumlahSoal}}{{if gt .JumlahEssay 0}} <span class="small text-muted">({{.JumlahEssay}} essay)</span>{{end}}</td>
                        <td class="text-center">{{.Selesai}}</td>
                        <td class="text-center">{{if gt .MenungguEssay 0}}<span class="badge bg-warning text-dark">{{.MenungguEssay}}</span>{{else}}<span class="text-muted">0</span>{{end}}</td>
                        <td class="text-end text-nowrap">
                            <a href="/guru/kelola-soal?ujian_id={{.ID}}" class="btn btn-sm btn-outline-primary" title="Kelola soal"><i class="bi bi-question-square"></i> Soal</a>
                            {{if gt .JumlahEssay 0}}<a href="/guru/essay/{{.ID}}" class="btn btn-sm btn-outline-warning" title="Nilai essay"><i class="bi bi-pencil-square"></i> Essay</a>{{end}}
                            <a href="/guru/hasil-siswa?ujian_id={{.ID}}" class="btn btn-sm btn-outline-secondary" title="Hasil"><i class="bi bi-trophy"></i></a>
                        </td>
                    </tr>
                    {{else}}
                    <tr><td colspan="8" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-1 d-block mb-2"></i>Belum ada ujian pada pengajaran Anda. Hubungi admin.</td></tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>

{{template "app_scripts"}}
</body>
</html>
