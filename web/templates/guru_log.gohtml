<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Log Pelanggaran — CBT Guru</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Log Pelanggaran Siswa (Guru)</h2>
        {{if .UjianID}}
        <a href="/guru/log-kecurangan/export?ujian_id={{.UjianID}}" class="btn btn-outline-success btn-sm">Unduh Excel</a>
        {{end}}
    </div>
    <table class="table">
        <thead><tr><th>Waktu</th><th>NIS</th><th>Nama Siswa</th><th>Kelas</th><th>Ujian</th><th>Pelanggaran</th><th>Perangkat</th></tr></thead>
        <tbody>
            {{range .LogList}}
            <tr>
                <td>{{.Timestamp.Format "02/01/2006 15:04:05"}}</td>
                <td>{{.NIS}}</td>
                <td>{{.NamaSiswa}}</td>
                <td>{{.Kelas}}</td>
                <td>{{.NamaUjian}}</td>
                <td><span class="badge bg-warning text-dark">{{.JenisKecurangan}}</span></td>
                <td>{{.DeviceType}}</td>
            </tr>
            {{else}}
            <tr><td colspan="7">Belum ada catatan pelanggaran.</td></tr>
            {{end}}
        </tbody>
    </table>
</div>
</body>
</html>

