<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Kelola Soal — CBT Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container my-4">
    <h2>Kelola Soal Ujian (Admin)</h2>
    {{if .Error}}<div class="alert alert-danger">{{.Error}}</div>{{end}}
    {{if .Success}}<div class="alert alert-success">{{.Success}}</div>{{end}}
    <table class="table">
        <thead><tr><th>#</th><th>Tipe</th><th>Teks Soal</th><th>Poin</th></tr></thead>
        <tbody>
            {{range .SoalList}}
            <tr><td>{{.ID}}</td><td>{{.TipeSoal}}</td><td>{{.TeksSoal}}</td><td>{{.Poin}}</td></tr>
            {{else}}
            <tr><td colspan="4">Belum ada data soal.</td></tr>
            {{end}}
        </tbody>
    </table>
</div>
</body>
</html>

