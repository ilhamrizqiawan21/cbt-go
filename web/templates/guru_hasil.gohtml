<!DOCTYPE html>
<html lang="id">
<head>{{template "app_head" "Hasil Siswa"}}</head>
<body class="bg-light">
{{template "guru_navbar" .}}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="page-title mb-1"><i class="bi bi-trophy text-success me-2"></i>Hasil Siswa</h3>
            <p class="text-muted mb-0">Nilai akhir = total poin ÷ poin maksimum × 100. "Menunggu essay" berarti masih ada essay yang belum Anda nilai.</p>
        </div>
        <div class="page-actions d-flex flex-wrap gap-2">
            <form method="GET" action="/guru/hasil-siswa">
                <select name="ujian_id" class="form-select" style="min-width:260px" aria-label="Pilih ujian" onchange="this.form.submit()">
                    {{range .UjianList}}
                    <option value="{{.ID}}" {{if eq .ID $.UjianID}}selected{{end}}>{{.NamaUjian}} — {{.NamaKelas}}</option>
                    {{else}}
                    <option value="">Belum ada ujian</option>
                    {{end}}
                </select>
            </form>
            {{if .UjianID}}
            <a href="/guru/hasil-siswa/export?ujian_id={{.UjianID}}" class="btn btn-success"><i class="bi bi-file-earmark-excel me-1"></i> Ekspor Excel</a>
            {{end}}
        </div>
    </div>

    {{template "app_flash" .}}

    {{if not .UjianID}}
    <div class="alert alert-info text-center py-4">Belum ada ujian pada pengajaran Anda.</div>
    {{else}}
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white small text-muted">{{len .HasilList}} siswa telah menyelesaikan ujian</div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width:50px">No</th>
                        <th>NIS</th>
                        <th>Nama</th>
                        <th>Kelas</th>
                        <th class="text-center">Benar / Salah / Kosong</th>
                        <th class="text-center">Poin otomatis</th>
                        <th class="text-center">Poin essay</th>
                        <th class="text-center">Nilai</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    {{range $i, $h := .HasilList}}
                    <tr>
                        <td class="text-center text-muted">{{add $i 1}}</td>
                        <td class="font-monospace">{{$h.NIS}}</td>
                        <td class="fw-semibold">{{$h.NamaSiswa}}</td>
                        <td>{{$h.Kelas}}</td>
                        <td class="text-center text-nowrap"><span class="text-success">{{$h.Benar}}</span> / <span class="text-danger">{{$h.Salah}}</span> / <span class="text-muted">{{$h.Kosong}}</span></td>
                        <td class="text-center">{{$h.PoinOtomatis}}</td>
                        <td class="text-center">{{$h.PoinEssay}}</td>
                        <td class="text-center"><span class="fw-bold">{{$h.NilaiAkhir}}</span><div class="small text-muted">{{add $h.PoinOtomatis $h.PoinEssay}}/{{$h.PoinMaks}}</div></td>
                        <td class="text-center">
                            {{if eq $h.StatusKoreksi "selesai"}}<span class="badge bg-success-subtle text-success-emphasis">Selesai</span>
                            {{else}}<a href="/guru/essay/{{$.UjianID}}" class="badge bg-warning-subtle text-warning-emphasis text-decoration-none">Menunggu essay</a>{{end}}
                        </td>
                    </tr>
                    {{else}}
                    <tr><td colspan="9" class="text-center py-5 text-muted">Belum ada siswa yang menyelesaikan ujian ini.</td></tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
    {{end}}
</div>

{{template "app_scripts"}}
</body>
</html>
