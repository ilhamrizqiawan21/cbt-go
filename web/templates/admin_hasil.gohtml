<!DOCTYPE html>
<html lang="id">
<head>{{template "app_head" "Hasil Ujian"}}</head>
<body class="bg-light">
{{template "admin_navbar" .}}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="page-title mb-1"><i class="bi bi-trophy text-primary me-2"></i>Hasil &amp; Rekap Nilai</h3>
            <p class="text-muted mb-0">Nilai akhir = total poin ÷ poin maksimum × 100 (dibulatkan). Essay dinilai guru.</p>
        </div>
        {{if .UjianID}}
        <div class="page-actions d-flex flex-wrap gap-2">
            <a href="/admin/hasil/export?ujian_id={{.UjianID}}" class="btn btn-success"><i class="bi bi-file-earmark-excel me-1"></i> Ekspor Excel</a>
            <a href="/admin/hasil/cetak/{{.UjianID}}" target="_blank" rel="noopener" class="btn btn-outline-secondary"><i class="bi bi-printer me-1"></i> Cetak</a>
            <a href="/admin/hasil/hadir/{{.UjianID}}" target="_blank" rel="noopener" class="btn btn-outline-secondary"><i class="bi bi-person-check me-1"></i> Daftar hadir</a>
        </div>
        {{end}}
    </div>

    {{template "app_flash" .}}

    <form method="GET" action="/admin/hasil" class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2 row g-2 align-items-center">
            <div class="col-md-5">
                <select name="ujian_id" class="form-select form-select-sm" aria-label="Pilih ujian" onchange="this.form.submit()">
                    {{range .UjianList}}
                    <option value="{{.ID}}" {{if eq .ID $.UjianID}}selected{{end}}>{{.NamaUjian}} — {{.NamaKelas}}</option>
                    {{else}}
                    <option value="">Belum ada ujian</option>
                    {{end}}
                </select>
            </div>
            <div class="col-md-3">
                <select name="kelas" class="form-select form-select-sm" aria-label="Filter kelas siswa" onchange="this.form.submit()">
                    <option value="">Semua kelas</option>
                    {{range .KelasList}}
                    <option value="{{.NamaKelas}}" {{if eq .NamaKelas $.Filter}}selected{{end}}>{{.NamaKelas}}</option>
                    {{end}}
                </select>
            </div>
            <div class="col-md-4 text-md-end small text-muted">
                {{len .HasilList}} siswa telah menyelesaikan ujian
            </div>
        </div>
    </form>

    {{if not .UjianID}}
    <div class="alert alert-info text-center py-4"><i class="bi bi-info-circle fs-2 d-block mb-2"></i>Belum ada ujian.</div>
    {{else}}
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width:50px">No</th>
                        <th>NIS</th>
                        <th>Nama</th>
                        <th>Kelas</th>
                        <th class="text-center">Benar / Salah / Kosong</th>
                        <th class="text-center">Poin otomatis</th>
                        <th class="text-center">Poin essay</th>
                        <th class="text-center">Nilai</th>
                        <th class="text-center">Status koreksi</th>
                        <th>Selesai</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    {{range $i, $h := .HasilList}}
                    <tr>
                        <td class="text-center text-muted">{{add $i 1}}</td>
                        <td class="font-monospace">{{$h.NIS}}</td>
                        <td class="fw-semibold">{{$h.NamaSiswa}}</td>
                        <td>{{if $h.Kelas}}<span class="badge bg-light text-dark border">{{$h.Kelas}}</span>{{end}}</td>
                        <td class="text-center text-nowrap">
                            <span class="text-success">{{$h.Benar}}</span> /
                            <span class="text-danger">{{$h.Salah}}</span> /
                            <span class="text-muted">{{$h.Kosong}}</span>
                        </td>
                        <td class="text-center">{{$h.PoinOtomatis}}</td>
                        <td class="text-center">{{$h.PoinEssay}}</td>
                        <td class="text-center"><span class="fs-6 fw-bold">{{$h.NilaiAkhir}}</span><div class="small text-muted">{{add $h.PoinOtomatis $h.PoinEssay}}/{{$h.PoinMaks}}</div></td>
                        <td class="text-center">
                            {{if eq $h.StatusKoreksi "selesai"}}
                            <span class="badge bg-success-subtle text-success-emphasis"><i class="bi bi-check2-circle me-1"></i>Selesai</span>
                            {{else}}
                            <span class="badge bg-warning-subtle text-warning-emphasis"><i class="bi bi-hourglass-split me-1"></i>Menunggu essay</span>
                            {{end}}
                        </td>
                        <td class="small text-nowrap">{{if not $h.SelesaiPada.IsZero}}{{$h.SelesaiPada.Format "02/01/2006 15:04"}}{{else}}-{{end}}</td>
                        <td class="text-end">
                            <form method="POST" action="/admin/reset-ujian" class="d-inline"
                                  data-confirm="Reset ujian {{$h.NIS}} – {{$h.NamaSiswa}}? Jawaban, nilai, log pelanggaran, dan sesinya dihapus sehingga siswa dapat mengulang. Tindakan ini tidak dapat dibatalkan.">
                                <input type="hidden" name="siswa_id" value="{{$h.SiswaID}}">
                                <input type="hidden" name="ujian_id" value="{{$.UjianID}}">
                                <input type="hidden" name="kembali" value="/admin/hasil?ujian_id={{$.UjianID}}">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Reset ujian siswa"><i class="bi bi-arrow-counterclockwise"></i></button>
                            </form>
                        </td>
                    </tr>
                    {{else}}
                    <tr><td colspan="11" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-1 d-block mb-2"></i>Belum ada siswa yang menyelesaikan ujian ini.</td></tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
    {{end}}
</div>

{{template "app_scripts"}}
</body>
</html>
