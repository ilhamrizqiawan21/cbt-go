<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Hasil Ujian — CBT Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Hasil Ujian Siswa (Admin)</h2>
        {{if .UjianID}}
        <div>
            <a href="/admin/hasil/export?ujian_id={{.UjianID}}" class="btn btn-outline-success btn-sm me-2">Unduh Excel</a>
            <a href="/admin/hasil/cetak/{{.UjianID}}" target="_blank" class="btn btn-outline-secondary btn-sm">Cetak</a>
        </div>
        {{end}}
    </div>
    <table class="table">
        <thead><tr><th>NIS</th><th>Nama Siswa</th><th>Kelas</th><th>Nilai Akhir</th><th>Status</th></tr></thead>
        <tbody>
            {{range .HasilList}}
            <tr><td>{{.NIS}}</td><td>{{.NamaSiswa}}</td><td>{{.Kelas}}</td><td>{{.NilaiAkhir}}</td><td>{{.StatusKoreksi}}</td></tr>
            {{else}}
            <tr><td colspan="5">Belum ada data nilai.</td></tr>
            {{end}}
        </tbody>
    </table>
</div>
</body>
</html>

