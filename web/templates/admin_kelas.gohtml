<!DOCTYPE html>
<html lang="id">
<head>{{template "app_head" "Data Kelas"}}</head>
<body class="bg-light">
{{template "admin_navbar" .}}

<div class="container py-4" style="max-width:900px">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="page-title mb-1"><i class="bi bi-building text-primary me-2"></i>Data Kelas</h3>
            <p class="text-muted mb-0">Mengganti nama kelas juga memperbarui kelas pada data siswa.</p>
        </div>
        <div class="page-actions d-flex gap-2">
            <button type="button" class="btn btn-primary" id="btnTambah"><i class="bi bi-plus-lg me-1"></i> Tambah Kelas</button>
        </div>
    </div>

    {{template "app_flash" .}}

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width:60px">No</th>
                        <th>Nama kelas</th>
                        <th class="text-end" style="width:160px">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    {{range $i, $k := .KelasList}}
                    <tr>
                        <td class="text-center text-muted">{{add $i 1}}</td>
                        <td><span class="badge bg-secondary fs-6">{{$k.NamaKelas}}</span></td>
                        <td class="text-end text-nowrap">
                            <a href="/admin/siswa?kelas={{$k.NamaKelas}}" class="btn btn-sm btn-outline-secondary" title="Lihat siswa"><i class="bi bi-people"></i></a>
                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-id="{{$k.ID}}" data-nama="{{$k.NamaKelas}}" title="Edit"><i class="bi bi-pencil"></i></button>
                            <form method="POST" action="/admin/kelas/hapus/{{$k.ID}}" class="d-inline"
                                  data-confirm="Hapus kelas {{$k.NamaKelas}}? Pengajaran dan SEMUA ujian kelas ini (beserta soal, jawaban, nilai) ikut terhapus. Data siswa tidak terhapus.">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    {{else}}
                    <tr><td colspan="3" class="text-center py-4 text-muted">Belum ada data kelas.</td></tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalKelas" tabindex="-1" aria-labelledby="modalKelasLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="POST" action="/admin/kelas/tambah" class="modal-content" id="formKelas">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalKelasLabel">Tambah Kelas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>
            <div class="modal-body">
                <label for="k_nama" class="form-label fw-semibold">Nama kelas</label>
                <input type="text" name="nama_kelas" id="k_nama" class="form-control" maxlength="30" required placeholder="Contoh: VII-A">
                <div class="form-text">Harus sama persis dengan kolom kelas pada file impor siswa.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Simpan</button>
            </div>
        </form>
    </div>
</div>

{{template "app_scripts"}}
<script>
    (() => {
        const modal = new bootstrap.Modal(document.getElementById('modalKelas'));
        const form = document.getElementById('formKelas');
        const buka = (id, nama) => {
            form.action = id ? '/admin/kelas/edit/' + id : '/admin/kelas/tambah';
            document.getElementById('modalKelasLabel').textContent = id ? 'Edit Kelas' : 'Tambah Kelas';
            document.getElementById('k_nama').value = nama || '';
            modal.show();
        };
        document.getElementById('btnTambah').addEventListener('click', () => buka('', ''));
        document.querySelectorAll('.btn-edit').forEach((b) => b.addEventListener('click', () => buka(b.dataset.id, b.dataset.nama)));
    })();
</script>
</body>
</html>
