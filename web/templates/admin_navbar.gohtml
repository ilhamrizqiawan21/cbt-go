{{define "admin_navbar"}}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
    <div class="container-fluid px-3">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/admin/dashboard">
            <img src="/images/logo-sekolah.png" alt="" width="30" height="30" class="d-inline-block">
            <span class="fw-bold">CBT Admin</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav" aria-controls="adminNav" aria-expanded="false" aria-label="Buka menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="adminNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link {{if eq .ActiveMenu "dashboard"}}active fw-semibold{{end}}" href="/admin/dashboard">
                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{if eq .ActiveMenu "monitor"}}active fw-semibold{{end}}" href="/admin/monitor">
                        <i class="bi bi-display me-1"></i> Monitor
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{if eq .ActiveMenu "ujian"}}active fw-semibold{{end}}" href="/admin/ujian">
                        <i class="bi bi-card-checklist me-1"></i> Ujian
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{if eq .ActiveMenu "soal"}}active fw-semibold{{end}}" href="/admin/soal">
                        <i class="bi bi-question-square me-1"></i> Bank Soal
                    </a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle {{if or (eq .ActiveMenu "siswa") (eq .ActiveMenu "guru") (eq .ActiveMenu "kelas") (eq .ActiveMenu "mapel") (eq .ActiveMenu "pengajaran")}}active fw-semibold{{end}}" href="#" id="masterDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-database me-1"></i> Data Master
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark shadow" aria-labelledby="masterDropdown">
                        <li><a class="dropdown-item {{if eq .ActiveMenu "siswa"}}active{{end}}" href="/admin/siswa"><i class="bi bi-people me-2"></i>Siswa</a></li>
                        <li><a class="dropdown-item {{if eq .ActiveMenu "guru"}}active{{end}}" href="/admin/guru"><i class="bi bi-person-badge me-2"></i>Guru</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item {{if eq .ActiveMenu "kelas"}}active{{end}}" href="/admin/kelas"><i class="bi bi-building me-2"></i>Kelas</a></li>
                        <li><a class="dropdown-item {{if eq .ActiveMenu "mapel"}}active{{end}}" href="/admin/mapel"><i class="bi bi-journal-bookmark me-2"></i>Mata Pelajaran</a></li>
                        <li><a class="dropdown-item {{if eq .ActiveMenu "pengajaran"}}active{{end}}" href="/admin/pengajaran"><i class="bi bi-link-45deg me-2"></i>Pengajaran</a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{if eq .ActiveMenu "hasil"}}active fw-semibold{{end}}" href="/admin/hasil">
                        <i class="bi bi-trophy me-1"></i> Hasil
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{if eq .ActiveMenu "analisis"}}active fw-semibold{{end}}" href="/admin/analisis">
                        <i class="bi bi-bar-chart-line me-1"></i> Analisis
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{if eq .ActiveMenu "log"}}active fw-semibold{{end}}" href="/admin/log-kecurangan">
                        <i class="bi bi-shield-exclamation me-1"></i> Log &amp; Reset
                    </a>
                </li>
            </ul>

            <div class="d-flex align-items-center gap-3">
                <span class="navbar-text text-light small">
                    <a href="/admin/akun" class="text-light text-decoration-none" title="Akun saya"><i class="bi bi-person-circle me-1"></i>{{if .Username}}{{.Username}}{{else}}Admin{{end}}</a>
                </span>
                <a href="/logout-admin" class="btn btn-outline-light btn-sm" data-confirm="Keluar dari panel admin?">
                    <i class="bi bi-box-arrow-right me-1"></i> Keluar
                </a>
            </div>
        </div>
    </div>
</nav>
{{end}}
