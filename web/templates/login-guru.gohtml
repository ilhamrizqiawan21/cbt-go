<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Guru — CBT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon.png">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/images/favicon.png">
    <style>
        :root{ --success:#0ca678; --success-dark:#087f5b; }
        *{ box-sizing:border-box; margin:0; padding:0; }
        body{
            font-family:'DM Sans',sans-serif;
            background: linear-gradient(135deg,#087f5b 0%,#0ca678 60%,#38d9a9 100%);
            min-height:100vh;
            display:flex; align-items:center; justify-content:center;
            padding:1rem;
        }
        .login-wrapper{ width:100%; max-width:400px; }
        .login-brand{ text-align:center; margin-bottom:2rem; }
        .login-brand img{ width:60px; height:60px; object-fit:contain; margin-bottom:.75rem; }
        .login-brand h1{
            font-family:'Sora',sans-serif; font-size:1.3rem;
            font-weight:800; color:#fff; letter-spacing:-.03em;
        }
        .login-brand p{ font-size:.8rem; color:rgba(255,255,255,.65); margin-top:.25rem; }
        .login-card{
            background:#fff; border-radius:18px;
            box-shadow:0 8px 40px rgba(0,0,0,.2);
            overflow:hidden;
        }
        .login-card-header{
            background:linear-gradient(135deg,var(--success-dark),var(--success));
            padding:1.25rem 1.75rem;
            display:flex; align-items:center; gap:.65rem;
        }
        .login-card-header i{ font-size:1.2rem; color:rgba(255,255,255,.85); }
        .login-card-header h2{
            font-family:'Sora',sans-serif; font-size:.93rem;
            font-weight:700; color:#fff; margin:0;
        }
        .login-card-body{ padding:1.75rem; }
        .alert-custom{
            background:#fff0f0; border-left:4px solid #e03131;
            border-radius:8px; padding:.7rem 1rem;
            font-size:.85rem; color:#c92a2a;
            margin-bottom:1.25rem;
            display:flex; align-items:center; gap:.5rem;
        }
        .form-group{ margin-bottom:1rem; }
        .form-label{
            font-size:.78rem; font-weight:600; color:#74788d;
            letter-spacing:.02em; display:block; margin-bottom:.35rem;
        }
        .input-wrap{ position:relative; }
        .input-wrap i{
            position:absolute; left:.85rem; top:50%;
            transform:translateY(-50%); color:#adb5bd;
            font-size:.95rem; pointer-events:none;
        }
        .form-control{
            width:100%; border:1.5px solid #e2e5ec; border-radius:8px;
            font-family:'DM Sans',sans-serif; font-size:.875rem;
            padding:.6rem .85rem .6rem 2.4rem;
            transition:all .2s; background:#fafbff; color:#2d3142;
        }
        .form-control:focus{
            border-color:var(--success);
            box-shadow:0 0 0 3px rgba(12,166,120,.15);
            outline:none; background:#fff;
        }
        .btn-login{
            width:100%;
            background:linear-gradient(135deg,var(--success-dark),var(--success));
            color:#fff; border:none; border-radius:8px;
            padding:.7rem 1rem;
            font-family:'Sora',sans-serif; font-size:.9rem; font-weight:700;
            cursor:pointer; transition:all .22s;
            display:flex; align-items:center; justify-content:center; gap:.5rem;
            margin-top:1.25rem;
        }
        .btn-login:hover{ transform:translateY(-1px); box-shadow:0 4px 16px rgba(12,166,120,.4); }
        .btn-login:active{ transform:translateY(0); }
        .login-links{
            text-align:center; margin-top:1.5rem;
            font-size:.78rem; color:rgba(255,255,255,.65);
        }
        .login-links a{ color:#fff; font-weight:600; text-decoration:none; }
        .login-links a:hover{ text-decoration:underline; }
        .login-links .divider{ margin:0 .5rem; }
        @media(max-width:480px){
            .login-card-body{ padding:1.25rem; }
        }
    </style>
</head>
<body>
<div class="login-wrapper">
    <div class="login-brand">
        <img src="/images/logo-sekolah.png" alt="Logo" onerror="this.style.display='none'">
        <h1>CBT Guru</h1>
        <h1>MTs. AL-IHSAN BATUJAJAR</h1>
        <p>Portal Pengajar — Kelola Ujian & Soal</p>
    </div>

    <div class="login-card">
        <div class="login-card-header">
            <i class="bi bi-person-badge"></i>
            <h2>Login Guru</h2>
        </div>
        <div class="login-card-body">
            {{ if .Error }}
            <div class="alert-custom">
                <i class="bi bi-exclamation-circle-fill"></i>
                {{ .Error }}
            </div>
            {{ end }}

            <form method="POST" action="/login-guru">
                <div class="form-group">
                    <label class="form-label">Username</label>
                    <div class="input-wrap">
                        <i class="bi bi-person-fill"></i>
                        <input type="text" name="username" class="form-control"
                               placeholder="Masukkan username" required autocomplete="username">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Password</label>
                    <div class="input-wrap">
                        <i class="bi bi-lock-fill"></i>
                        <input type="password" name="password" class="form-control"
                               placeholder="Masukkan password" required autocomplete="current-password">
                    </div>
                </div>
                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Masuk sebagai Guru
                </button>
            </form>
        </div>
    </div>

    <div class="login-links">
        <a href="/login-admin"><i class="bi bi-shield-lock"></i> Login Admin</a>
        <span class="divider">|</span>
        <a href="/login"><i class="bi bi-laptop"></i> Login Siswa</a>
    </div>
</div>
</body>
</html>

