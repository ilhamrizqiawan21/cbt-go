<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Ujian CBT — {{.Siswa.Nama}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <style>
        :root{
            --primary:#3b5bdb; --primary-light:#eef2ff; --primary-rgb:59,91,219;
            --success:#0ca678; --success-light:#e6f8f3; --success-rgb:12,166,120;
            --warning:#e67700; --warning-light:#fff3cd;
            --danger:#e03131; --danger-light:#fff0f0; --danger-rgb:224,49,49;
            --bg:#f0f2f8; --card:#fff;
            --font-body:'DM Sans',sans-serif;
            --font-heading:'Sora',sans-serif;
            --font-arabic:'Amiri',serif;
            --shadow-sm:0 2px 8px rgba(0,0,0,.07);
            --shadow-md:0 4px 20px rgba(0,0,0,.10);
            --radius:14px; --radius-sm:8px;
            --exam-font-scale: 1;
        }
        *{ box-sizing:border-box; margin:0; padding:0; }
        html{ font-size:16px; }
        body{ font-family:var(--font-body); background:var(--bg); min-height:100vh; -webkit-font-smoothing:antialiased; }

        /* Kontrol Ukuran Teks (A- / A+) (T2.2) */
        .font-size-ctrl {
            display: inline-flex;
            align-items: center;
            background: #f1f3f5;
            border: 1px solid #dee2e6;
            border-radius: 20px;
            padding: 2px 4px;
            gap: 2px;
        }
        .btn-font-size {
            background: none;
            border: none;
            border-radius: 50%;
            width: 44px;
            height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.78rem;
            font-weight: 700;
            color: #495057;
            cursor: pointer;
            transition: all 0.18s;
            padding: 0;
        }
        .btn-font-size:hover {
            background: #fff;
            color: var(--primary);
            box-shadow: 0 1px 4px rgba(0,0,0,.1);
        }
        .btn-font-size:active {
            transform: scale(0.92);
        }
        .font-size-label {
            font-size: 0.68rem;
            font-weight: 600;
            color: #868e96;
            padding: 0 3px;
            user-select: none;
        }

        /* Terapkan skala font pada soal */
        .soal-text {
            font-size: calc(0.95rem * var(--exam-font-scale)) !important;
        }
        .form-check-label {
            font-size: calc(0.88rem * var(--exam-font-scale)) !important;
        }
        .soal-text.ar, .form-check-label.ar {
            font-size: calc(1.35rem * var(--exam-font-scale)) !important;
        }

        /* ══════════════════════════════════════════
           FIX #8 — OVERLAY 1: Sebelum ujian dimulai
           Siswa wajib klik tombol untuk masuk fullscreen
           ══════════════════════════════════════════ */
        #fs-overlay{
            position:fixed; inset:0; z-index:9000;
            background:linear-gradient(135deg,#1a1f36 0%,#2c3461 100%);
            display:flex; align-items:center; justify-content:center;
            flex-direction:column; text-align:center; padding:2rem;
        }
        #fs-overlay .fs-icon{
            font-size:4rem; color:#748ffc; margin-bottom:1.25rem;
            animation:bounce 1.6s ease-in-out infinite;
        }
        @keyframes bounce{ 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
        #fs-overlay h2{
            font-family:var(--font-heading); font-size:1.4rem; font-weight:800;
            color:#fff; margin-bottom:.65rem; letter-spacing:-.02em;
        }
        #fs-overlay p{ font-size:.9rem; color:rgba(255,255,255,.65); max-width:380px; line-height:1.6; margin-bottom:1.75rem; }
        #btn-enter-fs{
            background:linear-gradient(135deg,var(--primary),#4c6ef5);
            color:#fff; border:none; border-radius:10px;
            padding:.85rem 2.25rem;
            font-family:var(--font-heading); font-size:1rem; font-weight:700;
            cursor:pointer; transition:all .22s;
            box-shadow:0 4px 20px rgba(59,91,219,.4);
            display:flex; align-items:center; gap:.6rem;
        }
        #btn-enter-fs:hover{ transform:translateY(-2px); box-shadow:0 6px 28px rgba(59,91,219,.5); }
        #btn-enter-fs:active{ transform:translateY(0); }
        #btn-enter-fs:disabled{ opacity:.6; cursor:not-allowed; transform:none; }
        #fs-overlay .fs-note{ margin-top:1rem; font-size:.73rem; color:rgba(255,255,255,.3); }

        /* Browser tidak support Fullscreen API */
        #fs-not-supported{
            display:none; margin-top:.75rem;
            background:rgba(255,255,255,.08); border-radius:8px;
            padding:.65rem 1rem; font-size:.8rem; color:rgba(255,255,255,.6);
            max-width:360px;
        }

        /* ══════════════════════════════════════════
           FIX #8 — OVERLAY 2: Saat keluar fullscreen
           di tengah ujian — muncul hitungan mundur
           ══════════════════════════════════════════ */
        #fs-lost-overlay{
            display:none;
            position:fixed; inset:0; z-index:8000;
            background:rgba(224,49,49,.95);
            backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px);
            align-items:center; justify-content:center;
            flex-direction:column; text-align:center; padding:2rem;
        }
        #fs-lost-overlay.show{ display:flex; animation:fadeIn .25s ease; }
        #fs-lost-overlay .fl-icon{ font-size:3.5rem; color:#fff; margin-bottom:1rem; }
        #fs-lost-overlay h2{
            font-family:var(--font-heading); font-size:1.35rem;
            font-weight:800; color:#fff; margin-bottom:.5rem;
        }
        #fs-lost-overlay p{ font-size:.88rem; color:rgba(255,255,255,.8); max-width:360px; line-height:1.6; margin-bottom:1.25rem; }
        #fs-countdown{
            font-family:var(--font-heading); font-size:2.5rem; font-weight:800; color:#fff;
            background:rgba(0,0,0,.25); border-radius:12px;
            padding:.4rem 1.5rem; margin-bottom:1.25rem;
            min-width:100px; text-align:center;
        }
        #btn-reenter-fs{
            background:#fff; color:var(--danger); border:none; border-radius:10px;
            padding:.75rem 2rem;
            font-family:var(--font-heading); font-size:.95rem; font-weight:700;
            cursor:pointer; transition:all .2s;
            display:flex; align-items:center; gap:.5rem;
        }
        #btn-reenter-fs:hover{ transform:translateY(-1px); box-shadow:0 4px 16px rgba(0,0,0,.2); }

        /* ── Topbar ── */
        .exam-topbar{
            position:fixed; top:0; left:0; right:0; z-index:500;
            background:#fff; border-bottom:1px solid rgba(0,0,0,.07);
            box-shadow:var(--shadow-sm); padding:.6rem 1.25rem;
            display:flex; align-items:center; justify-content:space-between;
            gap:1rem; flex-wrap:nowrap; min-height:62px;
        }
        .exam-topbar-left{ display:flex; align-items:center; gap:.75rem; flex:1; min-width:0; }
        .exam-topbar-left img{ width:36px; height:36px; object-fit:contain; flex-shrink:0; }
        .exam-info-text{ overflow:hidden; }
        .exam-info-text .exam-name{ font-family:var(--font-heading); font-size:.9rem; font-weight:700; color:#1e2022; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .exam-info-text .exam-sub{ font-size:.72rem; color:#74788d; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .exam-topbar-right{ display:flex; align-items:center; gap:.65rem; flex-shrink:0; }

        /* Indikator fullscreen di topbar */
        #fs-indicator{
            display:flex; align-items:center; gap:.35rem;
            font-size:.72rem; font-weight:600;
            color:var(--success); background:var(--success-light);
            padding:.25rem .65rem; border-radius:20px;
            border:1px solid rgba(12,166,120,.2);
            transition:all .3s; cursor:pointer;
            user-select:none;
        }
        #fs-indicator.fs-off{
            color:var(--danger); background:var(--danger-light);
            border-color:rgba(224,49,49,.2);
            animation:blinkBorder .8s infinite;
        }
        @keyframes blinkBorder{ 0%,100%{border-color:rgba(224,49,49,.2)} 50%{border-color:var(--danger)} }
        #fs-indicator i{ font-size:.8rem; }

        /* Indikator sinkronisasi di topbar (T1.7) */
        #sync-indicator{
            display:flex; align-items:center; gap:.35rem;
            font-size:.72rem; font-weight:600;
            padding:.25rem .65rem; border-radius:20px;
            border:1px solid transparent;
            transition:all .3s; user-select:none;
        }
        #sync-indicator.sync-saved{
            color:var(--success); background:var(--success-light);
            border-color:rgba(12,166,120,.2);
        }
        #sync-indicator.sync-saving{
            color:var(--primary); background:var(--primary-light);
            border-color:rgba(59,91,219,.2);
        }
        #sync-indicator.sync-offline{
            color:var(--warning); background:var(--warning-light);
            border-color:rgba(230,119,0,.3);
            animation:blinkBorder .8s infinite;
        }
        #sync-indicator i{ font-size:.8rem; }

        /* Timer */
        #timer{
            font-family:var(--font-heading); font-size:1.4rem; font-weight:800;
            color:var(--primary); background:var(--primary-light);
            padding:.25rem 1rem; border-radius:10px;
            letter-spacing:-.01em; min-width:96px; text-align:center;
            display:inline-block; border:2px solid transparent; transition:all .3s;
        }
        #timer.warning{ color:var(--warning); background:var(--warning-light); border-color:var(--warning); animation:pulse .9s infinite; }
        #timer.danger { color:var(--danger);  background:var(--danger-light);  border-color:var(--danger);  animation:pulse .5s infinite; }
        @keyframes pulse{ 0%,100%{transform:scale(1)} 50%{transform:scale(1.04)} }
        .timer-label{ font-size:.6rem; color:#74788d; letter-spacing:.04em; text-align:center; margin-bottom:1px; }

        /* Progress strip */
        .progress-strip{ position:fixed; top:62px; left:0; right:0; z-index:490; height:3px; background:#e9ecef; }
        .progress-strip-bar{ height:100%; width:0%; background:linear-gradient(90deg,var(--primary),#38d9a9); transition:width .4s ease; }

        /* Main layout */
        .exam-main{ padding-top:78px; padding-bottom:2rem; }
        .exam-layout{ display:grid; grid-template-columns:1fr 250px; gap:1.25rem; max-width:1060px; margin:0 auto; padding:1.25rem; align-items:start; }

        /* Soal card */
        .soal-card{ background:var(--card); border-radius:var(--radius); box-shadow:var(--shadow-sm); padding:1.5rem; margin-bottom:1.1rem; border:2px solid transparent; transition:box-shadow .2s, border-color .2s; animation:fadeUp .28s ease both; }
        .soal-card:hover{ box-shadow:var(--shadow-md); border-color:rgba(var(--primary-rgb),.1); }
        @keyframes fadeUp{ from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
        @keyframes fadeIn{ from{opacity:0} to{opacity:1} }
        .soal-header{ display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; padding-bottom:.75rem; border-bottom:1px solid #f0f2f4; }
        .soal-number{ background:linear-gradient(135deg,var(--primary),#4c6ef5); color:#fff; padding:.28rem .85rem; border-radius:20px; font-size:.72rem; font-weight:700; font-family:var(--font-heading); box-shadow:0 2px 6px rgba(var(--primary-rgb),.3); }
        .soal-poin{ background:#f8f9fc; color:#74788d; padding:.28rem .75rem; border-radius:20px; font-size:.7rem; font-weight:600; border:1px solid #e9ecef; }
        .soal-text{ font-size:.945rem; line-height:1.7; color:#2c3e50; margin-bottom:1.2rem; }
        .pilihan-ganda .form-check{ padding:.7rem .9rem; border-radius:10px; border:1.5px solid #e2e5ec; margin-bottom:.5rem; cursor:pointer; transition:all .18s; background:#fafbff; display:flex; align-items:flex-start; gap:.6rem; }
        .pilihan-ganda .form-check:hover{ border-color:var(--primary); background:var(--primary-light); }
        .pilihan-ganda .form-check:has(input:checked){ border-color:var(--primary); background:var(--primary-light); box-shadow:inset 0 0 0 1px var(--primary); }
        .form-check-input{ width:17px; height:17px; margin-top:2px; flex-shrink:0; accent-color:var(--primary); cursor:pointer; }
        .form-check-label{ cursor:pointer; font-size:.88rem; color:#34495e; line-height:1.5; flex:1; }
        .pasangan-baris{ display:flex; flex-direction:column; gap:.35rem; padding:.6rem .75rem; background:#fafbff; border:1.5px solid #e2e5ec; border-radius:var(--radius-sm); }
        .pasangan-select{ min-height:44px; }
        .pasangan-kiri{ font-size:.92rem; color:#2c3e50; line-height:1.6; }
        .pasangan-kiri.ar{ font-size:calc(1.2rem * var(--exam-font-scale)); }
        .menjodohkan .form-select,.essay .form-control{ border-radius:var(--radius-sm); border:1.5px solid #e2e5ec; font-family:var(--font-body); font-size:.88rem; transition:all .2s; background:#fafbff; }
        .menjodohkan .form-select:focus,.essay .form-control:focus{ border-color:var(--primary); box-shadow:0 0 0 3px rgba(var(--primary-rgb),.12); outline:none; background:#fff; }
        .essay textarea{ resize:vertical; min-height:110px; }

        /* Navigator */
        .nav-panel{ background:var(--card); border-radius:var(--radius); box-shadow:var(--shadow-sm); padding:1.1rem; position:sticky; top:80px; }
        .nav-panel-title{ font-family:var(--font-heading); font-weight:700; font-size:.7rem; color:#74788d; text-transform:uppercase; letter-spacing:.09em; margin-bottom:.75rem; }
        .nav-grid{ display:grid; grid-template-columns:repeat(5,1fr); gap:5px; }
        .nav-btn{ width:100%; aspect-ratio:1; border-radius:var(--radius-sm); border:1.5px solid #e2e5ec; background:#fafbff; font-family:var(--font-heading); font-weight:700; font-size:.7rem; cursor:pointer; transition:all .18s; display:flex; align-items:center; justify-content:center; color:#2d3142; -webkit-tap-highlight-color:transparent; }
        .nav-btn:hover   { border-color:var(--primary); background:var(--primary-light); color:var(--primary); }
        .nav-btn.answered{ background:var(--primary); border-color:var(--primary); color:#fff; }
        .nav-legend{ display:flex; flex-wrap:wrap; gap:6px; margin-top:.8rem; }
        .nav-legend-item{ display:flex; align-items:center; gap:4px; font-size:.67rem; font-weight:600; color:#74788d; }
        .nav-dot{ width:10px; height:10px; border-radius:3px; border:1.5px solid #e2e5ec; }
        .nav-dot.answered{ background:var(--primary); border-color:var(--primary); }

        /* Submit */
        .btn-selesai{ width:100%; margin-top:1rem; background:linear-gradient(135deg,var(--success),#12b886); color:#fff; border:none; border-radius:var(--radius-sm); padding:.75rem 1rem; font-family:var(--font-heading); font-size:.9rem; font-weight:700; cursor:pointer; transition:all .22s; box-shadow:0 3px 12px rgba(var(--success-rgb),.3); display:flex; align-items:center; justify-content:center; gap:.5rem; }
        .btn-selesai:hover{ transform:translateY(-1px); box-shadow:0 5px 18px rgba(var(--success-rgb),.4); }
        .btn-selesai:disabled{ opacity:.6; cursor:not-allowed; transform:none; box-shadow:none; }

        /* Info panel */
        .exam-info-panel{ background:var(--primary-light); border-radius:var(--radius-sm); padding:.65rem .9rem; margin-bottom:1rem; font-size:.78rem; color:var(--primary); font-weight:600; display:flex; align-items:center; gap:.5rem; border:1px solid rgba(var(--primary-rgb),.15); }

        /* Loading */
        .loading-box{ text-align:center; padding:3.5rem 2rem; background:#fff; border-radius:var(--radius); border:1px solid #e9ecef; }
        .spinner-ring{ width:42px; height:42px; margin:0 auto 1rem; border:3px solid #e9ecef; border-top-color:var(--primary); border-radius:50%; animation:spin .75s linear infinite; }
        @keyframes spin{ to{transform:rotate(360deg)} }
        .loading-box p{ color:#74788d; font-size:.875rem; }

        /* Toast */
        #warningToast{ position:fixed; bottom:1.25rem; right:1.25rem; z-index:1000; background:#fff; border-left:4px solid var(--warning); border-radius:10px; box-shadow:var(--shadow-md); padding:.9rem 1.1rem; display:none; align-items:center; gap:.65rem; font-size:.84rem; color:#7c4a00; max-width:340px; }
        #warningToast.show{ display:flex; animation:slideIn .3s ease; }
        @keyframes slideIn{ from{transform:translateX(110%);opacity:0} to{transform:translateX(0);opacity:1} }

        /* Floating nav toggle mobile */
        #navToggleFloat{ display:none; position:fixed; bottom:1.25rem; right:1.25rem; z-index:400; width:50px; height:50px; border-radius:50%; background:linear-gradient(135deg,var(--primary),#4c6ef5); color:#fff; border:none; box-shadow:0 4px 16px rgba(var(--primary-rgb),.4); font-size:1.2rem; cursor:pointer; align-items:center; justify-content:center; transition:all .22s; }

        /* Touch targets ≥ 44px & Mobile Ergonomics (T2.3) */
        .pilihan-ganda .form-check{
            min-height: 46px;
            padding: .75rem 1rem;
            align-items: center;
        }
        .form-check-input{
            width: 22px;
            height: 22px;
        }
        .nav-btn{
            min-height: 44px;
            font-size: .82rem;
        }
        .btn-selesai{
            min-height: 48px;
        }

        /* Responsive */
        @media(max-width:768px){
            .exam-topbar{ flex-wrap:wrap; padding:.55rem .75rem; min-height:56px; }
            .exam-topbar-right{ flex-wrap:wrap; width:100%; justify-content:space-between; gap:.4rem; }
            .exam-info-text .exam-sub{ display:none; }
            #timer{ font-size:1.05rem; min-width:74px; padding:.22rem .5rem; }
            .progress-strip{ top:var(--topbar-h, 56px); }
            .exam-main{ padding-top:calc(var(--topbar-h, 56px) + 12px); }
            .exam-layout{ grid-template-columns:1fr; padding:.75rem; padding-bottom:5.5rem; overflow-x:hidden; }
            .nav-panel{ position:fixed; bottom:0;left:0;right:0; border-radius:16px 16px 0 0; box-shadow:0 -4px 24px rgba(0,0,0,.15); transform:translateY(100%); transition:transform .32s ease; z-index:400; max-height:60vh; overflow-y:auto; padding:1.25rem 1rem; top:auto !important; }
            .nav-panel::before{ content:''; display:block; width:40px; height:5px; background:#ced4da; border-radius:99px; margin:0 auto 1rem; }
            .nav-panel.open{ transform:translateY(0); }
            .nav-grid{ grid-template-columns:repeat(5,1fr); gap:8px; }
            #navToggleFloat{ display:flex; min-width:48px; min-height:48px; }
            #fs-indicator span{ display:none; }
        }
        @media(max-width:480px){
            .exam-topbar{ padding:.45rem .6rem; }
            .soal-card{ padding:1.1rem .9rem; }
            .nav-grid{ grid-template-columns:repeat(5,1fr); gap:6px; }
        }
        @media(hover:none) and (pointer:coarse){
            .soal-card:hover{ box-shadow:var(--shadow-sm); border-color:transparent; }
            .btn-selesai:hover{ transform:none; }
            .nav-btn{ min-height:44px; }
        }
        @media print{
            .exam-topbar,.progress-strip,#warningToast,#navToggleFloat,.nav-panel,#fs-overlay,#fs-lost-overlay{ display:none !important; }
            .exam-main{ padding-top:0; }
            .exam-layout{ display:block; }
        }
    </style>
</head>
<body data-device-type="{{.DeviceType}}">

<!-- ══════════════════════════════════════════════
     FIX #8 — OVERLAY 1: Wajib fullscreen sebelum mulai
     ══════════════════════════════════════════════ -->
<div id="fs-overlay">
    <div class="fs-icon"><i class="bi bi-fullscreen"></i></div>
    <h2>Masuk Mode Layar Penuh</h2>
    <p>
        Ujian ini wajib dijalankan dalam mode layar penuh.<br>
        Keluar dari layar penuh selama ujian akan dicatat sebagai pelanggaran.
    </p>
    <button id="btn-enter-fs" type="button">
        <i class="bi bi-arrows-fullscreen"></i>
        Masuk Layar Penuh &amp; Mulai Ujian
    </button>
    <div id="fs-not-supported">
        <i class="bi bi-info-circle"></i>
        Browser Anda tidak mendukung mode layar penuh.
        Klik tombol di atas untuk melanjutkan tanpa layar penuh.
    </div>
    <p class="fs-note">Gunakan browser Chrome, Firefox, atau Edge terbaru untuk pengalaman terbaik.</p>
</div>

<!-- ══════════════════════════════════════════════
     FIX #8 — OVERLAY 2: Peringatan saat keluar fullscreen
     ══════════════════════════════════════════════ -->
<div id="fs-lost-overlay">
    <div class="fl-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
    <h2>Anda Keluar dari Layar Penuh!</h2>
    <p>
        Kembali ke layar penuh dalam hitungan mundur di bawah ini.<br>
        Jika tidak kembali, pelanggaran akan dicatat dan ujian dapat diakhiri.
    </p>
    <div id="fs-countdown">10</div>
    <button id="btn-reenter-fs" type="button">
        <i class="bi bi-arrows-fullscreen"></i>
        Kembali ke Layar Penuh
    </button>
</div>

<!-- ══ TOPBAR ══ -->
<div class="exam-topbar">
    <div class="exam-topbar-left">
        <img src="/images/logo-sekolah.png" alt="Logo" onerror="this.style.display='none'">
        <div class="exam-info-text">
            <div class="exam-name">
                <i class="bi bi-laptop" style="color:var(--success);margin-right:4px;"></i>
                {{.NamaUjian}}
            </div>
            <div class="exam-sub">
                {{.Siswa.Nama}} &nbsp;·&nbsp; NIS: {{if .Siswa.NIS}}{{.Siswa.NIS}}{{else}}{{.Siswa.ID}}{{end}}
                {{if .NamaMapel}}&nbsp;·&nbsp; {{.NamaMapel}}{{end}}
            </div>
        </div>
    </div>
    <div class="exam-topbar-right">
        <!-- Kontrol Ukuran Teks (A- / A+) (T2.2) -->
        <div class="font-size-ctrl" title="Atur ukuran teks">
            <button type="button" class="btn-font-size" id="btn-font-dec" aria-label="Kecilkan teks">A−</button>
            <span class="font-size-label" id="font-size-val">100%</span>
            <button type="button" class="btn-font-size" id="btn-font-inc" aria-label="Besarkan teks">A+</button>
        </div>
        <!-- Indikator sinkronisasi jawaban (T1.7) -->
        <div id="sync-indicator" class="sync-saved" title="Status penyimpanan jawaban">
            <i class="bi bi-cloud-check-fill" id="sync-icon"></i>
            <span id="sync-indicator-txt">Tersimpan</span>
        </div>
        <!-- Indikator fullscreen — klik untuk masuk kembali -->
        <div id="fs-indicator" class="fs-off" title="Klik untuk masuk layar penuh" role="button" tabindex="0">
            <i class="bi bi-fullscreen-exit"></i>
            <span id="fs-indicator-txt">Tidak Fullscreen</span>
        </div>
        <div>
            <div class="timer-label"><i class="bi bi-hourglass-split"></i> Sisa Waktu</div>
            <div id="timer">00:00</div>
        </div>
    </div>
</div>

<!-- Progress strip -->
<div class="progress-strip">
    <div class="progress-strip-bar" id="progressBar"></div>
</div>

<!-- ══ MAIN ══ -->
<div class="exam-main">
    <div class="exam-layout">

        <!-- Kolom soal -->
        <div id="soal-col">
            <div class="exam-info-panel">
                <i class="bi bi-info-circle-fill"></i>
                Jawaban tersimpan otomatis. Kerjakan semua soal sebelum waktu habis.
            </div>
            <div id="soal-container">
                <div class="loading-box">
                    <div class="spinner-ring"></div>
                    <p>Menghubungkan ke server ujian…</p>
                </div>
            </div>
            <div style="padding-bottom:1rem;">
                <button id="btn-selesai" class="btn-selesai">
                    <i class="bi bi-check2-circle"></i>
                    Selesai &amp; Kumpulkan
                </button>
            </div>
        </div>

        <!-- Navigator soal -->
        <div class="nav-panel" id="navPanel">
            <div class="nav-panel-title">Navigator Soal</div>
            <div class="nav-grid" id="navGrid"></div>
            <div class="nav-legend">
                <div class="nav-legend-item"><div class="nav-dot answered"></div> Dijawab</div>
                <div class="nav-legend-item"><div class="nav-dot"></div> Belum</div>
            </div>
        </div>

    </div>
</div>

<!-- Floating nav toggle (mobile) -->
<button id="navToggleFloat" aria-label="Buka navigator soal">
    <i class="bi bi-grid-3x3-gap-fill"></i>
</button>

<!-- Toast peringatan -->
<div id="warningToast">
    <i class="bi bi-exclamation-triangle-fill" style="color:var(--warning);font-size:1.1rem;flex-shrink:0;"></i>
    <span id="warningMessage">Peringatan!</span>
</div>

<!-- Variabel untuk ujian.js -->
<script>
    window.ujianId    = '{{.UjianID}}';
    window.siswaId    = '{{.Siswa.ID}}';
    window.siswaNama  = '{{.Siswa.Nama}}';
    window.deviceType = '{{if .DeviceType}}{{.DeviceType}}{{else}}laptop{{end}}';
</script>
<script src="/js/ujian.js"></script>

<!-- ══════════════════════════════════════════════
     FIX #8 — FULLSCREEN CONTROLLER
     Terpisah dari ujian.js agar mudah dipelihara.
     Dieksekusi setelah ujian.js dimuat.
     ══════════════════════════════════════════════ -->
<script>
(function() {

    /* ── Referensi elemen ── */
    const fsOverlay     = document.getElementById('fs-overlay');
    const fsLostOverlay = document.getElementById('fs-lost-overlay');
    const btnEnterFs    = document.getElementById('btn-enter-fs');
    const btnReenterFs  = document.getElementById('btn-reenter-fs');
    const fsCountdownEl = document.getElementById('fs-countdown');
    const fsIndicator   = document.getElementById('fs-indicator');
    const fsIndicatorTxt= document.getElementById('fs-indicator-txt');
    const fsNotSupported= document.getElementById('fs-not-supported');

    let ujianDimulai    = false; // True setelah siswa klik "Mulai"
    let fsCountdownTimer= null;
    let fsCountdownVal  = 10;
    // Berapa kali siswa sudah dapat peringatan keluar FS
    // (dicatat juga di server via socket)
    let fsPelanggaranCount = 0;

    const isHpDevice    = (window.deviceType === 'hp');

    /* ── Deteksi dukungan Fullscreen API ── */
    function fsSupported() {
        if (isHpDevice) return false;
        return !!(
            document.fullscreenEnabled       ||
            document.webkitFullscreenEnabled  ||
            document.mozFullScreenEnabled     ||
            document.msFullscreenEnabled
        );
    }

    /* ── Cek apakah saat ini fullscreen ── */
    function isFullscreen() {
        if (isHpDevice) return true; // Pada HP, fullscreen tidak diwajibkan
        return !!(
            document.fullscreenElement       ||
            document.webkitFullscreenElement  ||
            document.mozFullScreenElement     ||
            document.msFullscreenElement
        );
    }

    /* ── Request fullscreen pada <html> ── */
    function requestFs() {
        if (isHpDevice) return;
        const el = document.documentElement;
        const fn = el.requestFullscreen
                || el.webkitRequestFullscreen
                || el.mozRequestFullScreen
                || el.msRequestFullscreen;
        if (fn) fn.call(el).catch(() => {});
    }

    /* ── Update indikator di topbar ── */
    function updateFsIndicator(aktif) {
        if (!fsIndicator) return;
        if (isHpDevice) {
            fsIndicator.style.display = 'none'; // Sembunyikan indikator fullscreen di HP
            return;
        }
        if (aktif) {
            fsIndicator.classList.remove('fs-off');
            fsIndicatorTxt.textContent = 'Layar Penuh';
            fsIndicator.querySelector('i').className = 'bi bi-fullscreen';
        } else {
            fsIndicator.classList.add('fs-off');
            fsIndicatorTxt.textContent = 'Tidak Fullscreen';
            fsIndicator.querySelector('i').className = 'bi bi-fullscreen-exit';
        }
    }

    /* ── Hentikan hitungan mundur ── */
    function stopCountdown() {
        if (fsCountdownTimer) { clearInterval(fsCountdownTimer); fsCountdownTimer = null; }
        fsCountdownVal = 10;
        if (fsCountdownEl) fsCountdownEl.textContent = '10';
    }

    /* ── Mulai hitungan mundur 10 detik (Hanya Laptop, DESIGN §3.7, T5.2) ── */
    function startCountdown() {
        if (isHpDevice) return;
        stopCountdown();
        fsCountdownVal = 10;
        fsCountdownEl.textContent = fsCountdownVal;

        fsCountdownTimer = setInterval(() => {
            fsCountdownVal--;
            fsCountdownEl.textContent = fsCountdownVal;

            if (fsCountdownVal <= 0) {
                stopCountdown();
                // Catat pelanggaran ke server via socket
                fsPelanggaranCount++;
                if (typeof socket !== 'undefined') {
                    socket.emit('keluar-fullscreen');
                }
                // Sembunyikan overlay — ujian tetap berjalan
                // Hukuman sudah dicatat di server
                fsLostOverlay.classList.remove('show');
                // Coba masuk fullscreen otomatis sekali lagi
                requestFs();
            }
        }, 1000);
    }

    /* ── Handler saat fullscreenchange ── */
    function onFullscreenChange() {
        if (isHpDevice) return; // Pada HP, tidak ada event keluar-fullscreen palsu
        const aktif = isFullscreen();
        updateFsIndicator(aktif);

        if (!ujianDimulai) return; // Abaikan sebelum ujian dimulai

        if (aktif) {
            // Kembali fullscreen → sembunyikan overlay & hentikan countdown
            stopCountdown();
            fsLostOverlay.classList.remove('show');
        } else {
            // Keluar fullscreen → tampilkan overlay & mulai countdown
            fsLostOverlay.classList.add('show');
            startCountdown();
        }
    }

    // Pasang listener semua vendor prefix
    if (!isHpDevice) {
        ['fullscreenchange','webkitfullscreenchange','mozfullscreenchange','MSFullscreenChange']
            .forEach(evt => document.addEventListener(evt, onFullscreenChange));
    }

    /* ── Inisialisasi awal untuk HP vs Laptop ── */
    if (isHpDevice) {
        if (fsOverlay) fsOverlay.style.display = 'none';
        if (fsLostOverlay) fsLostOverlay.style.display = 'none';
        ujianDimulai = true;
        updateFsIndicator(true);
    }

    /* ── Tombol "Masuk Layar Penuh & Mulai Ujian" ── */
    if (btnEnterFs && !isHpDevice) {
        // Jika browser tidak support FS, tampilkan info
        if (!fsSupported()) {
            fsNotSupported.style.display = 'block';
            btnEnterFs.innerHTML = '<i class="bi bi-play-circle"></i> Mulai Ujian (Tanpa Layar Penuh)';
        }

        btnEnterFs.addEventListener('click', () => {
            btnEnterFs.disabled = true;
            btnEnterFs.innerHTML = '<i class="bi bi-hourglass-split"></i> Memuat ujian…';

            if (!fsSupported()) {
                // Browser tidak support — langsung mulai
                fsOverlay.style.display = 'none';
                ujianDimulai = true;
                updateFsIndicator(false);
                return;
            }

            requestFs();

            // Timeout 2.5 detik sebagai fallback jika event tidak terpicu
            let fsWait = setTimeout(() => {
                fsOverlay.style.display = 'none';
                ujianDimulai = true;
                updateFsIndicator(isFullscreen());
            }, 2500);

            function onFirstFs() {
                clearTimeout(fsWait);
                ['fullscreenchange','webkitfullscreenchange','mozfullscreenchange']
                    .forEach(e => document.removeEventListener(e, onFirstFs));
                fsOverlay.style.display = 'none';
                ujianDimulai = true;
                updateFsIndicator(true);
            }
            ['fullscreenchange','webkitfullscreenchange','mozfullscreenchange']
                .forEach(e => document.addEventListener(e, onFirstFs));
        });
    }

    /* ── Tombol "Kembali ke Layar Penuh" ── */
    if (btnReenterFs) {
        btnReenterFs.addEventListener('click', () => {
            requestFs();
            // onFullscreenChange akan handle sisanya
        });
    }

    /* ── Indikator di topbar juga bisa diklik untuk re-enter ── */
    if (fsIndicator) {
        fsIndicator.addEventListener('click', () => {
            if (!isFullscreen() && ujianDimulai) requestFs();
        });
        fsIndicator.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') requestFs();
        });
    }

    /* ── Escape key: cegah keluar fullscreen tanpa peringatan ──
       Tidak bisa benar-benar mencegah Esc, tapi kita deteksi
       lewat fullscreenchange event yang sudah terpasang.
       Ini hanya untuk blok keydown Esc agar tidak ada aksi lain. ── */
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && ujianDimulai && isFullscreen()) {
            // Browser akan keluar FS karena Esc tidak bisa dicegah,
            // onFullscreenChange akan handle peringatannya.
            // Tidak perlu aksi di sini.
        }
    });

    /* ── Mobile: Fullscreen API biasanya tidak tersedia ──
       Di mobile, orientasi landscape lebih optimal.
       Coba kunci orientasi ke landscape jika tersedia. ── */
    if (screen.orientation && screen.orientation.lock) {
        screen.orientation.lock('landscape').catch(() => {
            // Tidak semua perangkat/browser mendukung — abaikan error
        });
    }

    /* ── Expose ke global agar ujian.js bisa cek ── */
    window.ujianDimulai = function() { return ujianDimulai; };
    window.isFullscreen = isFullscreen;

    /* ══ Mobile nav drawer toggle ══ */
    const navPanel  = document.getElementById('navPanel');
    const navToggle = document.getElementById('navToggleFloat');
    if (navToggle && navPanel) {
        navToggle.addEventListener('click', () => navPanel.classList.toggle('open'));
        document.addEventListener('click', (e) => {
            if (!navPanel.contains(e.target) && !navToggle.contains(e.target)) {
                navPanel.classList.remove('open');
            }
        });
    }

})();
</script>
</body>
</html>
