<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Ujian CBT — {{.Siswa.Nama}}</title>
    <link href="/css/vendor/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/vendor/bootstrap-icons.min.css">
    <link href="/css/style.css" rel="stylesheet">
    <style>
        :root{
            --primary:#3b5bdb; --primary-hover:#2b44b0; --primary-light:#eef2ff; --primary-rgb:59,91,219;
            --success:#0b8a68; --success-light:#dcf5ec; --success-rgb:11,138,104;
            --warning:#8a5200; --warning-light:#fff1d6;
            --danger:#c92a2a; --danger-light:#ffe3e3; --danger-rgb:201,42,42;
            --dark-header:#101533; --dark-surface:#1d2552;
            --bg:#f4f6fb; --card:#ffffff;
            --border:#dfe3ee; --text:#1b2038; --text-muted:#5b6280;
            --font-body:'DM Sans',system-ui,sans-serif;
            --font-heading:'Sora',system-ui,sans-serif;
            --font-arabic:'Amiri',serif;
            --shadow-sm:0 1px 3px rgba(16,21,51,.08);
            --shadow-md:0 4px 20px rgba(16,21,51,.12);
            --radius:20px; --radius-sm:12px;
            --exam-font-scale: 1;
        }
        *{ box-sizing:border-box; margin:0; padding:0; }
        html{ font-size:16px; }
        body{ font-family:var(--font-body); background:var(--bg); color:var(--text); min-height:100vh; -webkit-font-smoothing:antialiased; }

        /* Kontrol Ukuran Teks (A- / A+) (MOCKUP §2) */
        .font-size-ctrl {
            display: inline-flex;
            align-items: center;
            background: var(--dark-surface);
            border-radius: 999px;
            padding: 0 4px;
        }
        .btn-font-size {
            background: transparent;
            border: none;
            border-radius: 50%;
            width: 44px;
            height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            transition: all 0.15s;
            padding: 0;
        }
        .btn-font-size:hover {
            color: #9db1ff;
            background: rgba(255,255,255,.08);
        }
        .btn-font-size:active {
            transform: scale(0.92);
        }
        .font-size-label {
            font-size: 0.75rem;
            font-weight: 600;
            color: #aab3de;
            min-width: 38px;
            text-align: center;
            user-select: none;
        }

        /* Skala font pada soal & pilihan */
        .soal-text {
            font-size: calc(1.05rem * var(--exam-font-scale)) !important;
            line-height: 1.65;
            color: var(--text);
        }
        .form-check-label {
            font-size: calc(0.95rem * var(--exam-font-scale)) !important;
            line-height: 1.45;
            color: var(--text);
        }
        .soal-text.ar, .form-check-label.ar {
            font-family: var(--font-arabic);
            font-size: calc(1.75rem * var(--exam-font-scale)) !important;
            line-height: 1.75 !important;
            text-align: right;
            direction: rtl;
        }

        /* ══════════════════════════════════════════
           OVERLAY 1: Sebelum ujian dimulai
           ══════════════════════════════════════════ */
        #fs-overlay{
            position:fixed; inset:0; z-index:9000;
            background:linear-gradient(135deg,#101533 0%,#1d2552 100%);
            display:flex; align-items:center; justify-content:center;
            flex-direction:column; text-align:center; padding:2rem;
        }
        #fs-overlay .fs-icon{
            font-size:3.5rem; color:#9db1ff; margin-bottom:1.25rem;
            animation:bounce 1.6s ease-in-out infinite;
        }
        @keyframes bounce{ 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
        #fs-overlay h2{
            font-family:var(--font-heading); font-size:1.45rem; font-weight:700;
            color:#fff; margin-bottom:.65rem; letter-spacing:-.02em;
        }
        #fs-overlay p{ font-size:.92rem; color:#cfd6f5; max-width:420px; line-height:1.6; margin-bottom:1.75rem; }
        #btn-enter-fs{
            background:var(--primary);
            color:#fff; border:none; border-radius:12px;
            padding:.85rem 2.25rem;
            font-family:var(--font-heading); font-size:1rem; font-weight:700;
            cursor:pointer; transition:all .2s;
            box-shadow:0 4px 18px rgba(59,91,219,.4);
            display:flex; align-items:center; gap:.6rem;
            min-height: 48px;
        }
        #btn-enter-fs:hover{ background:var(--primary-hover); transform:translateY(-1px); }
        #btn-enter-fs:active{ transform:translateY(0); }
        #btn-enter-fs:disabled{ opacity:.6; cursor:not-allowed; }
        #fs-overlay .fs-note{ margin-top:1.2rem; font-size:.78rem; color:#8d98c7; }

        /* Browser tidak support Fullscreen API */
        #fs-not-supported{
            display:none; margin-top:.75rem;
            background:rgba(255,255,255,.08); border-radius:8px;
            padding:.65rem 1rem; font-size:.8rem; color:#cfd6f5;
            max-width:360px;
        }

        /* ══════════════════════════════════════════
           OVERLAY 2: Saat keluar fullscreen
           ══════════════════════════════════════════ */
        #fs-lost-overlay{
            display:none;
            position:fixed; inset:0; z-index:8000;
            background:rgba(201,42,42,.96);
            backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px);
            align-items:center; justify-content:center;
            flex-direction:column; text-align:center; padding:2rem;
        }
        #fs-lost-overlay.show{ display:flex; animation:fadeIn .25s ease; }
        #fs-lost-overlay .fl-icon{ font-size:3.5rem; color:#fff; margin-bottom:1rem; }
        #fs-lost-overlay h2{
            font-family:var(--font-heading); font-size:1.4rem;
            font-weight:700; color:#fff; margin-bottom:.5rem;
        }
        #fs-lost-overlay p{ font-size:.9rem; color:rgba(255,255,255,.9); max-width:380px; line-height:1.6; margin-bottom:1.25rem; }
        #fs-countdown{
            font-family:var(--font-heading); font-size:2.5rem; font-weight:700; color:#fff;
            background:rgba(0,0,0,.25); border-radius:12px;
            padding:.4rem 1.5rem; margin-bottom:1.25rem;
            min-width:100px; text-align:center;
        }
        #btn-reenter-fs{
            background:#fff; color:var(--danger); border:none; border-radius:12px;
            padding:.75rem 2rem;
            font-family:var(--font-heading); font-size:1rem; font-weight:700;
            cursor:pointer; transition:all .2s;
            display:flex; align-items:center; gap:.5rem;
            min-height: 48px;
        }
        #btn-reenter-fs:hover{ transform:translateY(-1px); box-shadow:0 4px 16px rgba(0,0,0,.2); }

        /* ── Topbar (Mockup §1-3) ── */
        .exam-topbar{
            position:fixed; top:0; left:0; right:0; z-index:500;
            background:var(--dark-header); color:#fff;
            padding:12px 32px;
            display:flex; align-items:center; justify-content:space-between;
            gap:14px; flex-wrap:wrap; min-height:64px;
        }
        .exam-topbar-left{ display:flex; align-items:center; gap:14px; flex:1; min-width:0; }
        .exam-icon-badge{
            width:40px; height:40px; border-radius:12px;
            background:var(--primary); display:flex; align-items:center; justify-content:center;
            flex:none; color:#fff; font-size:1.25rem;
        }
        .exam-info-text{ overflow:hidden; min-width:0; }
        .exam-info-text .exam-name{
            font-family:var(--font-heading); font-size:1rem; font-weight:700;
            color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
        }
        .exam-info-text .exam-sub{
            font-size:0.82rem; color:#aab3de; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:2px;
        }
        .exam-topbar-right{ display:flex; align-items:center; gap:10px 14px; flex-wrap:wrap; }

        /* Status & Badge Pills */
        #sync-indicator{
            display:flex; align-items:center; gap:6px;
            font-size:0.82rem; font-weight:600;
            padding:8px 14px; border-radius:999px;
            user-select:none; transition:all .2s;
        }
        #sync-indicator.sync-saved{
            color:#7fe0bf; background:#12302f;
        }
        #sync-indicator.sync-saving{
            color:#9db1ff; background:var(--dark-surface);
        }
        #sync-indicator.sync-offline{
            color:var(--warning); background:var(--warning-light);
        }

        #fs-indicator{
            display:flex; align-items:center; gap:6px;
            font-size:0.82rem; font-weight:600;
            color:#cfd6f5; background:var(--dark-surface);
            padding:8px 14px; border-radius:999px;
            cursor:pointer; user-select:none; transition:all .2s;
        }
        #fs-indicator.fs-off{
            color:var(--danger); background:var(--danger-light);
        }

        .exam-violation-badge{
            font-size:0.82rem; font-weight:600; color:#cfd6f5;
            background:var(--dark-surface); border-radius:999px;
            padding:8px 14px; display:inline-flex; align-items:center;
        }

        /* Timer Block */
        .exam-timer-box{
            display:flex; align-items:center; gap:10px;
            background:var(--primary); border-radius:12px;
            padding:8px 16px; color:#fff;
        }
        .exam-timer-box.warning{ background:var(--warning); }
        .exam-timer-box.danger{ background:var(--danger); animation:pulse .6s infinite; }
        @keyframes pulse{ 0%,100%{transform:scale(1)} 50%{transform:scale(1.03)} }
        #timer{
            font-family:var(--font-heading); font-size:1.35rem; font-weight:700;
            font-variant-numeric:tabular-nums; letter-spacing:-.01em;
        }

        /* Progress strip */
        .progress-strip{ position:fixed; top:64px; left:0; right:0; z-index:490; height:4px; background:#d9def0; }
        .progress-strip-bar{ height:100%; width:0%; background:linear-gradient(90deg,var(--primary),var(--success)); transition:width .4s ease; }

        /* Main Layout (Mockup §1-3) */
        .exam-main{
            padding-top:84px; padding-bottom:3rem; min-height:calc(100vh - 84px);
            display:flex; justify-content:center;
        }
        .exam-layout{
            display:flex; flex-wrap:wrap; gap:24px; align-items:flex-start;
            max-width:1200px; width:100%; padding:20px 32px; box-sizing:border-box;
        }
        #soal-col{ flex:1 1 560px; min-width:0; display:flex; flex-direction:column; gap:18px; }

        /* Soal Card */
        .soal-card{
            background:var(--card); border-radius:var(--radius);
            box-shadow:var(--shadow-sm); padding:28px 32px;
            border:1px solid #dfe3ee; transition:box-shadow .2s;
            animation:fadeUp .24s ease both;
        }
        @keyframes fadeUp{ from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
        .soal-header{
            display:flex; justify-content:space-between; align-items:center;
            margin-bottom:1.1rem; padding-bottom:.75rem; border-bottom:1px solid #f0f2f8;
        }
        .soal-number{
            font-family:var(--font-heading); font-weight:700; font-size:1.05rem;
            color:var(--primary);
        }
        .soal-badges{ display:flex; align-items:center; gap:8px; }
        .soal-badge-type{
            font-size:0.78rem; font-weight:600; color:var(--text-muted);
            background:#e6e9f5; border-radius:999px; padding:4px 12px;
        }
        .soal-poin{
            background:#f8f9fc; color:var(--text-muted); padding:4px 10px;
            border-radius:999px; font-size:0.75rem; font-weight:600; border:1px solid #e9ecef;
        }
        .soal-text{
            margin-bottom:1.5rem; word-break:break-word;
        }

        /* Pilihan Ganda (Tombol Opsi Mockup 2 & 3) */
        .pilihan-ganda{ display:flex; flex-direction:column; gap:10px; }
        .pilihan-ganda .form-check{
            display:flex; align-items:center; gap:16px;
            min-height:58px; padding:12px 18px;
            border-radius:14px; box-sizing:border-box; width:100%;
            cursor:pointer; font:inherit; text-align:left;
            background:#fff; border:1px solid #cfd5e6;
            margin-bottom:0; transition:all .18s;
        }
        .pilihan-ganda .form-check:hover{
            border-color:var(--primary); background:#fafbff;
        }
        .pilihan-ganda .form-check:has(input:checked){
            border:2px solid var(--primary); background:var(--primary-light);
        }
        .pilihan-ganda .form-check-input{
            display:none; /* Sembunyikan radio default, pakai option-badge */
        }
        .option-badge{
            flex:none; width:36px; height:36px; border-radius:50%;
            display:flex; align-items:center; justify-content:center;
            font-family:var(--font-heading); font-weight:700; font-size:15px;
            background:#eef0f8; color:#3b4160; transition:all .18s;
        }
        .pilihan-ganda .form-check:has(input:checked) .option-badge{
            background:var(--primary); color:#fff;
        }
        .form-check-label{
            flex:1; cursor:pointer; margin:0; word-break:break-word;
        }

        /* Soal Menjodohkan */
        .pasangan-baris{
            display:flex; flex-direction:column; gap:.4rem;
            padding:.8rem 1rem; background:#fafbff;
            border:1.5px solid #dfe3ee; border-radius:var(--radius-sm);
        }
        .pasangan-select{ min-height:46px; border-radius:10px; }
        .pasangan-kiri{ font-size:.95rem; color:var(--text); line-height:1.6; }
        .pasangan-kiri.ar{ font-family:var(--font-arabic); font-size:calc(1.35rem * var(--exam-font-scale)); direction:rtl; text-align:right; }

        /* Soal Essay (D-008, Mockup Layar 2) */
        .essay-info-card{
            background:#fff7e6; border-radius:16px; padding:18px;
            display:flex; gap:14px; align-items:flex-start;
        }
        .essay-info-card .essay-icon{ flex:none; font-size:1.5rem; color:#8a5200; margin-top:2px; }
        .essay-info-title{ font-family:var(--font-heading); font-weight:700; font-size:1rem; color:#5c3700; }
        .essay-info-desc{ font-size:0.9rem; line-height:1.5; color:#7a4a00; margin-top:4px; }

        /* Navigator Panel Aside (Mockup Layar 3) */
        .nav-panel{
            flex:1 1 300px; max-width:380px; min-width:0;
            background:var(--card); border-radius:var(--radius);
            padding:22px; box-shadow:var(--shadow-sm); border:1px solid #dfe3ee;
            display:flex; flex-direction:column; gap:18px; position:sticky; top:84px;
        }
        .nav-panel-head{
            display:flex; align-items:baseline; justify-content:space-between;
        }
        .nav-panel-title{
            font-family:var(--font-heading); font-weight:700; font-size:1rem; color:var(--text);
        }
        .nav-panel-count{ font-size:0.82rem; color:var(--text-muted); }
        .nav-grid{ display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:8px; }
        .nav-btn{
            height:44px; border-radius:10px; font-family:var(--font-heading);
            font-weight:700; font-size:14px; cursor:pointer; box-sizing:border-box;
            background:#fff; color:var(--text); border:1.5px solid #aab1c9;
            display:flex; align-items:center; justify-content:center;
            transition:all .15s;
        }
        .nav-btn:hover{ border-color:var(--primary); color:var(--primary); background:var(--primary-light); }
        .nav-btn.answered{ background:var(--success); color:#fff; border-color:var(--success); }
        .nav-btn.active{ background:var(--primary); color:#fff; border-color:var(--primary); }

        .nav-legend{ display:flex; flex-wrap:wrap; gap:8px 16px; font-size:0.82rem; color:var(--text-muted); }
        .nav-legend-item{ display:flex; align-items:center; gap:6px; }
        .nav-legend-dot{ width:14px; height:14px; border-radius:4px; }
        .nav-legend-dot.answered{ background:var(--success); }
        .nav-legend-dot.empty{ border:1.5px solid #aab1c9; background:#fff; }
        .nav-legend-dot.current{ background:var(--primary); }

        .btn-selesai{
            height:52px; border:0; border-radius:12px;
            background:var(--success); color:#fff;
            font-family:var(--font-heading); font-weight:700; font-size:1rem;
            cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px;
            transition:all .2s; width:100%;
        }
        .btn-selesai:hover{ background:#097356; }
        .btn-selesai:disabled{ opacity:.6; cursor:not-allowed; }

        .exam-security-note{
            display:flex; gap:10px; font-size:0.82rem; line-height:1.5; color:var(--text-muted);
            background:var(--bg); border-radius:12px; padding:12px 14px;
        }

        /* Toast Peringatan */
        #warningToast{
            position:fixed; bottom:1.25rem; right:1.25rem; z-index:1000;
            background:#fff; border-left:4px solid var(--warning); border-radius:10px;
            box-shadow:var(--shadow-md); padding:.9rem 1.1rem; display:none;
            align-items:center; gap:.65rem; font-size:.85rem; color:#7c4a00; max-width:340px;
        }

        /* Floating Nav Toggle Mobile (HP) */
        #navToggleFloat{ display:none; }

        /* Responsive Breakpoints (HP Mockup Layar 2) */
        @media(max-width:991px){
            .exam-topbar{ padding:12px 16px 10px; min-height:auto; gap:10px; }
            .exam-topbar-left{ width:100%; justify-content:space-between; }
            .exam-topbar-right{ width:100%; justify-content:space-between; gap:8px; }
            .exam-violation-badge{ display:none; }
            .progress-strip{ top:var(--topbar-h, 114px); }
            .exam-main{ padding-top:calc(var(--topbar-h, 114px) + 12px); padding-bottom:80px; }
            .exam-layout{ padding:12px 16px; }
            .soal-card{ padding:20px 18px; border-radius:16px; }
            .nav-panel{
                position:fixed; bottom:0; left:0; right:0; max-width:100%;
                border-radius:20px 20px 0 0; box-shadow:0 -4px 30px rgba(16,21,51,.25);
                transform:translateY(100%); transition:transform .3s ease;
                z-index:900; max-height:75vh; overflow-y:auto; top:auto !important;
            }
            .nav-panel::before{
                content:''; display:block; width:44px; height:5px;
                background:#ced4da; border-radius:99px; margin:0 auto 12px;
            }
            .nav-panel.open{ transform:translateY(0); }
            #navToggleFloat{
                display:flex; position:fixed; bottom:1rem; right:1rem; z-index:450;
                width:52px; height:52px; border-radius:50%; background:var(--primary);
                color:#fff; border:none; box-shadow:0 4px 16px rgba(59,91,219,.4);
                font-size:1.25rem; align-items:center; justify-content:center; cursor:pointer;
            }
        }

        @media(max-width:480px){
            .pilihan-ganda .form-check{ padding:10px 14px; gap:12px; }
            .option-badge{ width:32px; height:32px; font-size:13px; }
        }

        @media print{
            .exam-topbar,.progress-strip,#warningToast,#navToggleFloat,.nav-panel,#fs-overlay,#fs-lost-overlay{ display:none !important; }
            .exam-main{ padding-top:0; }
            .exam-layout{ display:block; }
        }
    </style>
</head>
<body data-device-type="{{.DeviceType}}">

<!-- ══════════════════════════════════════════════
     FIX #8 — OVERLAY 1: Wajib fullscreen sebelum mulai
     ══════════════════════════════════════════════ -->
<div id="fs-overlay">
    <div class="fs-icon"><i class="bi bi-fullscreen"></i></div>
    <h2>Masuk Mode Layar Penuh</h2>
    <p>
        Ujian ini wajib dijalankan dalam mode layar penuh.<br>
        Keluar dari layar penuh selama ujian akan dicatat sebagai pelanggaran.
    </p>
    <button id="btn-enter-fs" type="button">
        <i class="bi bi-arrows-fullscreen"></i>
        Masuk Layar Penuh &amp; Mulai Ujian
    </button>
    <div id="fs-not-supported">
        <i class="bi bi-info-circle"></i>
        Browser Anda tidak mendukung mode layar penuh.
        Klik tombol di atas untuk melanjutkan tanpa layar penuh.
    </div>
    <p class="fs-note">Gunakan browser Chrome, Firefox, atau Edge terbaru untuk pengalaman terbaik.</p>
</div>

<!-- ══════════════════════════════════════════════
     FIX #8 — OVERLAY 2: Peringatan saat keluar fullscreen
     ══════════════════════════════════════════════ -->
<div id="fs-lost-overlay">
    <div class="fl-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
    <h2>Anda Keluar dari Layar Penuh!</h2>
    <p>
        Kembali ke layar penuh dalam hitungan mundur di bawah ini.<br>
        Jika tidak kembali, pelanggaran akan dicatat dan ujian dapat diakhiri.
    </p>
    <div id="fs-countdown">10</div>
    <button id="btn-reenter-fs" type="button">
        <i class="bi bi-arrows-fullscreen"></i>
        Kembali ke Layar Penuh
    </button>
</div>

<!-- ══ TOPBAR ══ -->
<div class="exam-topbar">
    <div class="exam-topbar-left">
        <div class="exam-icon-badge" aria-hidden="true">
            <i class="bi bi-journal-text"></i>
        </div>
        <div class="exam-info-text">
            <div class="exam-name">
                {{.NamaUjian}}
            </div>
            <div class="exam-sub">
                {{.Siswa.Nama}} &nbsp;·&nbsp; NIS: {{if .Siswa.NIS}}{{.Siswa.NIS}}{{else}}{{.Siswa.ID}}{{end}}
                {{if .Siswa.Kelas}}&nbsp;·&nbsp; {{.Siswa.Kelas}}{{end}}
                {{if .NamaMapel}}&nbsp;·&nbsp; {{.NamaMapel}}{{end}}
            </div>
        </div>
    </div>
    <div class="exam-topbar-right">
        <!-- Indikator sinkronisasi jawaban (T1.7) -->
        <div id="sync-indicator" class="sync-saved" title="Status penyimpanan jawaban">
            <i class="bi bi-cloud-check-fill" id="sync-icon"></i>
            <span id="sync-indicator-txt">Tersimpan</span>
        </div>
        <!-- Indikator fullscreen — klik untuk masuk kembali -->
        <div id="fs-indicator" class="fs-off" title="Klik untuk masuk layar penuh" role="button" tabindex="0">
            <i class="bi bi-fullscreen"></i>
            <span id="fs-indicator-txt">Layar penuh</span>
        </div>
        <!-- Indikator pelanggaran (laptop) -->
        <div class="exam-violation-badge" id="violationBadge" title="Status kepatuhan ujian">
            Pelanggaran <span id="violation-count" style="margin: 0 4px; font-weight:700;">0</span> dari 3
        </div>
        <!-- Kontrol Ukuran Teks (A- / A+) (T2.2) -->
        <div class="font-size-ctrl" title="Atur ukuran teks">
            <button type="button" class="btn-font-size" id="btn-font-dec" aria-label="Kecilkan teks">A−</button>
            <span class="font-size-label" id="font-size-val">100%</span>
            <button type="button" class="btn-font-size" id="btn-font-inc" aria-label="Besarkan teks">A+</button>
        </div>
        <!-- Timer Server-Authoritative -->
        <div class="exam-timer-box" id="timerBox">
            <i class="bi bi-stopwatch" style="font-size:1.15rem;"></i>
            <span id="timer">00:00</span>
        </div>
    </div>
</div>

<!-- Progress strip -->
<div class="progress-strip">
    <div class="progress-strip-bar" id="progressBar"></div>
</div>

<!-- ══ MAIN ══ -->
<div class="exam-main">
    <div class="exam-layout">

        <!-- Kolom soal -->
        <div id="soal-col">
            <div id="soal-container">
                <div class="loading-box">
                    <div class="spinner-ring"></div>
                    <p>Menghubungkan ke server ujian…</p>
                </div>
            </div>
        </div>

        <!-- Navigator soal -->
        <div class="nav-panel" id="navPanel">
            <div class="nav-panel-head">
                <div class="nav-panel-title">Navigator Soal</div>
                <div class="nav-panel-count"><span id="answeredCount">0</span> terjawab</div>
            </div>
            <div class="nav-grid" id="navGrid"></div>
            <div class="nav-legend">
                <div class="nav-legend-item"><span class="nav-legend-dot answered"></span> Dijawab</div>
                <div class="nav-legend-item"><span class="nav-legend-dot empty"></span> Belum</div>
                <div class="nav-legend-item"><span class="nav-legend-dot current"></span> Sedang dibuka</div>
            </div>
            <button id="btn-selesai" class="btn-selesai">
                <i class="bi bi-check2-circle"></i>
                Kumpulkan Ujian
            </button>
            <div class="exam-security-note">
                <i class="bi bi-shield-exclamation text-primary fs-5 flex-shrink-0"></i>
                <span>Berpindah tab atau keluar layar penuh dicatat sebagai pelanggaran. Tiga kali, ujian terkunci sampai pengawas membukanya.</span>
            </div>
        </div>

    </div>
</div>

<!-- Floating nav toggle (mobile) -->
<button id="navToggleFloat" aria-label="Buka navigator soal">
    <i class="bi bi-grid-3x3-gap-fill"></i>
</button>

<!-- Toast peringatan -->
<div id="warningToast">
    <i class="bi bi-exclamation-triangle-fill" style="color:var(--warning);font-size:1.1rem;flex-shrink:0;"></i>
    <span id="warningMessage">Peringatan!</span>
</div>

<!-- Variabel untuk ujian.js -->
<script>
    window.ujianId    = '{{.UjianID}}';
    window.siswaId    = '{{.Siswa.ID}}';
    window.siswaNama  = '{{.Siswa.Nama}}';
    window.deviceType = '{{if .DeviceType}}{{.DeviceType}}{{else}}laptop{{end}}';
</script>
<script src="/js/ujian.js"></script>

<!-- ══════════════════════════════════════════════
     FIX #8 — FULLSCREEN CONTROLLER
     Terpisah dari ujian.js agar mudah dipelihara.
     Dieksekusi setelah ujian.js dimuat.
     ══════════════════════════════════════════════ -->
<script>
(function() {

    /* ── Referensi elemen ── */
    const fsOverlay     = document.getElementById('fs-overlay');
    const fsLostOverlay = document.getElementById('fs-lost-overlay');
    const btnEnterFs    = document.getElementById('btn-enter-fs');
    const btnReenterFs  = document.getElementById('btn-reenter-fs');
    const fsCountdownEl = document.getElementById('fs-countdown');
    const fsIndicator   = document.getElementById('fs-indicator');
    const fsIndicatorTxt= document.getElementById('fs-indicator-txt');
    const fsNotSupported= document.getElementById('fs-not-supported');

    let ujianDimulai    = false; // True setelah siswa klik "Mulai"
    let fsCountdownTimer= null;
    let fsCountdownVal  = 10;
    // Berapa kali siswa sudah dapat peringatan keluar FS
    // (dicatat juga di server via socket)
    let fsPelanggaranCount = 0;

    const isHpDevice    = (window.deviceType === 'hp');

    /* ── Deteksi dukungan Fullscreen API ── */
    function fsSupported() {
        if (isHpDevice) return false;
        return !!(
            document.fullscreenEnabled       ||
            document.webkitFullscreenEnabled  ||
            document.mozFullScreenEnabled     ||
            document.msFullscreenEnabled
        );
    }

    /* ── Cek apakah saat ini fullscreen ── */
    function isFullscreen() {
        if (isHpDevice) return true; // Pada HP, fullscreen tidak diwajibkan
        return !!(
            document.fullscreenElement       ||
            document.webkitFullscreenElement  ||
            document.mozFullScreenElement     ||
            document.msFullscreenElement
        );
    }

    /* ── Request fullscreen pada <html> ── */
    function requestFs() {
        if (isHpDevice) return;
        const el = document.documentElement;
        const fn = el.requestFullscreen
                || el.webkitRequestFullscreen
                || el.mozRequestFullScreen
                || el.msRequestFullscreen;
        if (fn) fn.call(el).catch(() => {});
    }

    /* ── Update indikator di topbar ── */
    function updateFsIndicator(aktif) {
        if (!fsIndicator) return;
        if (isHpDevice) {
            fsIndicator.style.display = 'none'; // Sembunyikan indikator fullscreen di HP
            return;
        }
        if (aktif) {
            fsIndicator.classList.remove('fs-off');
            fsIndicatorTxt.textContent = 'Layar Penuh';
            fsIndicator.querySelector('i').className = 'bi bi-fullscreen';
        } else {
            fsIndicator.classList.add('fs-off');
            fsIndicatorTxt.textContent = 'Tidak Fullscreen';
            fsIndicator.querySelector('i').className = 'bi bi-fullscreen-exit';
        }
    }

    /* ── Hentikan hitungan mundur ── */
    function stopCountdown() {
        if (fsCountdownTimer) { clearInterval(fsCountdownTimer); fsCountdownTimer = null; }
        fsCountdownVal = 10;
        if (fsCountdownEl) fsCountdownEl.textContent = '10';
    }

    /* ── Mulai hitungan mundur 10 detik (Hanya Laptop, DESIGN §3.7, T5.2) ── */
    function startCountdown() {
        if (isHpDevice) return;
        stopCountdown();
        fsCountdownVal = 10;
        fsCountdownEl.textContent = fsCountdownVal;

        fsCountdownTimer = setInterval(() => {
            fsCountdownVal--;
            fsCountdownEl.textContent = fsCountdownVal;

            if (fsCountdownVal <= 0) {
                stopCountdown();
                // Catat pelanggaran ke server via socket
                fsPelanggaranCount++;
                if (typeof socket !== 'undefined') {
                    socket.emit('keluar-fullscreen');
                }
                // Sembunyikan overlay — ujian tetap berjalan
                // Hukuman sudah dicatat di server
                fsLostOverlay.classList.remove('show');
                // Coba masuk fullscreen otomatis sekali lagi
                requestFs();
            }
        }, 1000);
    }

    /* ── Handler saat fullscreenchange ── */
    function onFullscreenChange() {
        if (isHpDevice) return; // Pada HP, tidak ada event keluar-fullscreen palsu
        const aktif = isFullscreen();
        updateFsIndicator(aktif);

        if (!ujianDimulai) return; // Abaikan sebelum ujian dimulai

        if (aktif) {
            // Kembali fullscreen → sembunyikan overlay & hentikan countdown
            stopCountdown();
            fsLostOverlay.classList.remove('show');
        } else {
            // Keluar fullscreen → tampilkan overlay & mulai countdown
            fsLostOverlay.classList.add('show');
            startCountdown();
        }
    }

    // Pasang listener semua vendor prefix
    if (!isHpDevice) {
        ['fullscreenchange','webkitfullscreenchange','mozfullscreenchange','MSFullscreenChange']
            .forEach(evt => document.addEventListener(evt, onFullscreenChange));
    }

    /* ── Inisialisasi awal untuk HP vs Laptop ── */
    if (isHpDevice) {
        if (fsOverlay) fsOverlay.style.display = 'none';
        if (fsLostOverlay) fsLostOverlay.style.display = 'none';
        ujianDimulai = true;
        updateFsIndicator(true);
    }

    /* ── Tombol "Masuk Layar Penuh & Mulai Ujian" ── */
    if (btnEnterFs && !isHpDevice) {
        // Jika browser tidak support FS, tampilkan info
        if (!fsSupported()) {
            fsNotSupported.style.display = 'block';
            btnEnterFs.innerHTML = '<i class="bi bi-play-circle"></i> Mulai Ujian (Tanpa Layar Penuh)';
        }

        btnEnterFs.addEventListener('click', () => {
            btnEnterFs.disabled = true;
            btnEnterFs.innerHTML = '<i class="bi bi-hourglass-split"></i> Memuat ujian…';

            if (!fsSupported()) {
                // Browser tidak support — langsung mulai
                fsOverlay.style.display = 'none';
                ujianDimulai = true;
                updateFsIndicator(false);
                return;
            }

            requestFs();

            // Timeout 2.5 detik sebagai fallback jika event tidak terpicu
            let fsWait = setTimeout(() => {
                fsOverlay.style.display = 'none';
                ujianDimulai = true;
                updateFsIndicator(isFullscreen());
            }, 2500);

            function onFirstFs() {
                clearTimeout(fsWait);
                ['fullscreenchange','webkitfullscreenchange','mozfullscreenchange']
                    .forEach(e => document.removeEventListener(e, onFirstFs));
                fsOverlay.style.display = 'none';
                ujianDimulai = true;
                updateFsIndicator(true);
            }
            ['fullscreenchange','webkitfullscreenchange','mozfullscreenchange']
                .forEach(e => document.addEventListener(e, onFirstFs));
        });
    }

    /* ── Tombol "Kembali ke Layar Penuh" ── */
    if (btnReenterFs) {
        btnReenterFs.addEventListener('click', () => {
            requestFs();
            // onFullscreenChange akan handle sisanya
        });
    }

    /* ── Indikator di topbar juga bisa diklik untuk re-enter ── */
    if (fsIndicator) {
        fsIndicator.addEventListener('click', () => {
            if (!isFullscreen() && ujianDimulai) requestFs();
        });
        fsIndicator.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') requestFs();
        });
    }

    /* ── Escape key: cegah keluar fullscreen tanpa peringatan ──
       Tidak bisa benar-benar mencegah Esc, tapi kita deteksi
       lewat fullscreenchange event yang sudah terpasang.
       Ini hanya untuk blok keydown Esc agar tidak ada aksi lain. ── */
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && ujianDimulai && isFullscreen()) {
            // Browser akan keluar FS karena Esc tidak bisa dicegah,
            // onFullscreenChange akan handle peringatannya.
            // Tidak perlu aksi di sini.
        }
    });

    /* ── Mobile: Fullscreen API biasanya tidak tersedia ──
       Di mobile, orientasi landscape lebih optimal.
       Coba kunci orientasi ke landscape jika tersedia. ── */
    if (screen.orientation && screen.orientation.lock) {
        screen.orientation.lock('landscape').catch(() => {
            // Tidak semua perangkat/browser mendukung — abaikan error
        });
    }

    /* ── Expose ke global agar ujian.js bisa cek ── */
    window.ujianDimulai = function() { return ujianDimulai; };
    window.isFullscreen = isFullscreen;

    /* ══ Mobile nav drawer toggle ══ */
    const navPanel  = document.getElementById('navPanel');
    const navToggle = document.getElementById('navToggleFloat');
    if (navToggle && navPanel) {
        navToggle.addEventListener('click', () => navPanel.classList.toggle('open'));
        document.addEventListener('click', (e) => {
            if (!navPanel.contains(e.target) && !navToggle.contains(e.target)) {
                navPanel.classList.remove('open');
            }
        });
    }

})();
</script>
</body>
</html>
