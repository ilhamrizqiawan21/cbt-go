<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Penilaian Essay — CBT Guru</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container my-4">
    <h2>Penilaian Essay Siswa</h2>
    {{if .Error}}<div class="alert alert-danger">{{.Error}}</div>{{end}}
    {{if .Success}}<div class="alert alert-success">{{.Success}}</div>{{end}}
    {{if .UjianID}}
    <div class="mb-3">
        <a href="/guru/essay/{{.UjianID}}/export" class="btn btn-outline-success btn-sm me-2">Unduh Template Excel</a>
    </div>
    {{end}}
    <table class="table">
        <thead><tr><th>NIS</th><th>Nama Siswa</th><th>Soal</th><th>Jawaban Siswa</th><th>Skor</th></tr></thead>
        <tbody>
            {{range .JawabanList}}
            <tr>
                <td>{{.NIS}}</td>
                <td>{{.NamaSiswa}}</td>
                <td>{{.TeksSoal}}</td>
                <td>{{.JawabanSiswa}}</td>
                <td>{{if .Skor}}{{.Skor}}{{else}}<em>Belum dinilai</em>{{end}}</td>
            </tr>
            {{else}}
            <tr><td colspan="5">Belum ada jawaban essay.</td></tr>
            {{end}}
        </tbody>
    </table>
</div>
</body>
</html>

