<!DOCTYPE html>
<html lang="id">
<head>{{template "app_head" "Log Pelanggaran & Reset"}}</head>
<body class="bg-light">
{{template "admin_navbar" .}}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="page-title mb-1"><i class="bi bi-shield-exclamation text-danger me-2"></i>Log Pelanggaran &amp; Reset</h3>
            <p class="text-muted mb-0">Riwayat pindah tab, keluar layar penuh, copy-paste, ambil alih sesi, dan buka kunci.</p>
        </div>
        <div class="page-actions d-flex gap-2">
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalResetSemua">
                <i class="bi bi-exclamation-octagon me-1"></i> Reset Semua Peserta
            </button>
        </div>
    </div>

    {{template "app_flash" .}}

    <form method="GET" action="/admin/log-kecurangan" class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2 row g-2 align-items-center">
            <div class="col-md-5">
                <select name="ujian_id" class="form-select form-select-sm" aria-label="Filter ujian" onchange="this.form.submit()">
                    <option value="">Semua ujian</option>
                    {{range .UjianList}}
                    <option value="{{.ID}}" {{if eq .ID $.UjianID}}selected{{end}}>{{.NamaUjian}} — {{.NamaKelas}}</option>
                    {{end}}
                </select>
            </div>
            <div class="col-md-3">
                <select name="jenis" class="form-select form-select-sm" aria-label="Filter jenis" onchange="this.form.submit()">
                    <option value="">Semua jenis</option>
                    {{range $j := list "pindah_tab" "keluar_fullscreen" "copy_paste" "ambil_alih_sesi" "buka_kunci"}}
                    <option value="{{$j}}" {{if eq $j $.Filter}}selected{{end}}>{{template "label_jenis" $j}}</option>
                    {{end}}
                </select>
            </div>
            <div class="col-md-4 text-md-end small text-muted">{{len .LogList}} catatan</div>
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width:50px">No</th>
                        <th>Waktu</th>
                        <th>Siswa</th>
                        <th>Kelas</th>
                        <th>Ujian</th>
                        <th>Jenis</th>
                        <th class="text-center">Perangkat</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    {{range $i, $l := .LogList}}
                    <tr>
                        <td class="text-center text-muted">{{add $i 1}}</td>
                        <td class="small font-monospace text-nowrap">{{$l.Timestamp.Format "02/01/2006 15:04:05"}}</td>
                        <td><div class="fw-semibold">{{$l.NamaSiswa}}</div><div class="small text-muted font-monospace">{{$l.NIS}}</div></td>
                        <td>{{if $l.Kelas}}<span class="badge bg-secondary-subtle text-secondary-emphasis">{{$l.Kelas}}</span>{{end}}</td>
                        <td>{{$l.NamaUjian}}</td>
                        <td>
                            {{if eq $l.JenisKecurangan "buka_kunci"}}<span class="badge bg-success-subtle text-success-emphasis">
                            {{else if eq $l.JenisKecurangan "ambil_alih_sesi"}}<span class="badge bg-info-subtle text-info-emphasis">
                            {{else}}<span class="badge bg-danger-subtle text-danger-emphasis">{{end}}{{template "label_jenis" $l.JenisKecurangan}}</span>
                        </td>
                        <td class="text-center text-nowrap">
                            {{if eq $l.DeviceType "hp"}}<i class="bi bi-phone"></i> HP
                            {{else if eq $l.DeviceType "laptop"}}<i class="bi bi-laptop"></i> Laptop
                            {{else}}<span class="text-muted">-</span>{{end}}
                        </td>
                        <td class="text-end">
                            <form method="POST" action="/admin/reset-ujian" class="d-inline"
                                  data-confirm="Reset ujian {{$l.NamaUjian}} untuk {{$l.NIS}} – {{$l.NamaSiswa}}? Jawaban, nilai, log, dan sesinya dihapus sehingga siswa dapat mengulang.">
                                <input type="hidden" name="siswa_id" value="{{$l.SiswaID}}">
                                <input type="hidden" name="ujian_id" value="{{$l.UjianID}}">
                                <input type="hidden" name="kembali" value="/admin/log-kecurangan{{if $.UjianID}}?ujian_id={{$.UjianID}}{{end}}">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Reset ujian siswa ini"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
                            </form>
                        </td>
                    </tr>
                    {{else}}
                    <tr><td colspan="8" class="text-center py-5 text-muted"><i class="bi bi-shield-check fs-1 text-success d-block mb-2"></i>Tidak ada catatan pelanggaran.</td></tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white small text-muted">
            Siswa tanpa catatan pelanggaran dapat direset dari halaman <a href="/admin/hasil">Hasil</a> atau <a href="/admin/monitor">Monitor</a>.
        </div>
    </div>
</div>

<!-- Modal Reset Semua Peserta -->
<div class="modal fade" id="modalResetSemua" tabindex="-1" aria-labelledby="modalResetSemuaLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="POST" action="/admin/reset-ujian-semua" class="modal-content border-danger"
              data-confirm="APAKAH ANDA BENAR-BENAR YAKIN? Data seluruh peserta pada ujian ini dihapus permanen.">
            <input type="hidden" name="kembali" value="/admin/log-kecurangan">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="modalResetSemuaLabel"><i class="bi bi-exclamation-octagon-fill me-2"></i>Reset Seluruh Peserta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger small">
                    Menghapus <strong>seluruh sesi, jawaban, nilai, dan log</strong> semua siswa pada ujian yang dipilih.
                    Soal dan data ujian tidak terhapus. Tindakan ini tidak dapat dibatalkan.
                </div>
                <div class="mb-3">
                    <label for="reset_all_ujian_id" class="form-label fw-semibold">Ujian</label>
                    <select class="form-select" id="reset_all_ujian_id" name="ujian_id" required>
                        <option value="">-- Pilih ujian --</option>
                        {{range .UjianList}}
                        <option value="{{.ID}}" {{if eq .ID $.UjianID}}selected{{end}}>{{.NamaUjian}} — {{.NamaKelas}}</option>
                        {{end}}
                    </select>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="confirm_danger" required>
                    <label class="form-check-label small text-danger fw-semibold" for="confirm_danger">
                        Saya memahami seluruh data peserta ujian ini akan hilang.
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash-fill me-1"></i> Reset Semua</button>
            </div>
        </form>
    </div>
</div>

{{template "app_scripts"}}
</body>
</html>
