<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CBT Sekolah</title>
    <link href="/css/vendor/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/vendor/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon.png">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <style>
        :root { --primary: #3b5bdb; --bg: #f0f2f8; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .wrap { width: 100%; max-width: 420px; }
        .brand { text-align: center; margin-bottom: 1.5rem; }
        .brand img { width: 64px; height: 64px; object-fit: contain; margin-bottom: .75rem; }
        .brand h1 { font-family: 'Sora', sans-serif; font-size: 1.35rem; font-weight: 800; color: #1e2022; letter-spacing: -.03em; }
        .brand p { font-size: .85rem; color: #74788d; margin-top: .25rem; }
        .role {
            display: flex; align-items: center; gap: 1rem;
            background: #fff; border-radius: 14px; padding: 1rem 1.25rem;
            margin-bottom: .75rem; text-decoration: none; color: #1e2022;
            box-shadow: 0 2px 12px rgba(0,0,0,.08);
            min-height: 64px;
            transition: transform .15s, box-shadow .15s;
        }
        .role:hover, .role:focus-visible { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,.12); color: #1e2022; }
        .role i.icon { font-size: 1.5rem; color: var(--primary); }
        .role strong { font-family: 'Sora', sans-serif; font-size: .95rem; display: block; }
        .role span { font-size: .8rem; color: #74788d; }
        .role .go { margin-left: auto; color: #adb5bd; }
        .role.siswa { background: linear-gradient(135deg, var(--primary), #4c6ef5); color: #fff; padding: 1.25rem; }
        .role.siswa i.icon, .role.siswa span, .role.siswa .go { color: rgba(255,255,255,.9); }
        .role.siswa:hover { color: #fff; }
        .others { font-size: .75rem; color: #74788d; text-transform: uppercase; letter-spacing: .06em; margin: 1.25rem 0 .5rem .25rem; }
    </style>
</head>
<body>
    <main class="wrap">
        <div class="brand">
            <img src="/images/favicon.png" alt="Logo sekolah">
            <h1>Ujian CBT Sekolah</h1>
            <p>Pilih halaman masuk Anda</p>
        </div>

        <a class="role siswa" href="/login">
            <i class="bi bi-pencil-square icon"></i>
            <div><strong>Masuk sebagai Siswa</strong><span>Kerjakan ujian dengan NIS dan PIN</span></div>
            <i class="bi bi-chevron-right go"></i>
        </a>

        <p class="others">Staf sekolah</p>
        <a class="role" href="/login-guru">
            <i class="bi bi-person-workspace icon"></i>
            <div><strong>Guru</strong><span>Kelola soal dan nilai essay</span></div>
            <i class="bi bi-chevron-right go"></i>
        </a>
        <a class="role" href="/login-admin">
            <i class="bi bi-shield-lock icon"></i>
            <div><strong>Admin</strong><span>Kelola ujian dan pantau peserta</span></div>
            <i class="bi bi-chevron-right go"></i>
        </a>
    </main>
</body>
</html>

