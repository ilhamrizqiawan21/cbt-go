{{/*
  Navigasi panel guru: sidebar yang bisa dibuka-tutup + topbar.
  Nama partial tetap "guru_navbar" agar seluruh halaman guru tidak perlu diubah.
  Kerangka, gaya, dan skripnya ada di sidebar.gohtml.
*/}}
{{define "guru_navbar"}}
{{template "app_sidebar_style"}}
<style>:root { --app-sidebar-bg: #0f3b2e; }</style>

<aside class="app-sidebar" id="appSidebar">
    <a class="app-sidebar-brand" href="/guru/dashboard">
        <img src="/images/logo-sekolah.png" alt="" width="30" height="30">
        <span class="fw-bold">CBT Guru</span>
    </a>

    <ul class="app-sidebar-nav">
        <li>
            <a class="app-nav-link {{if eq .ActiveMenu "dashboard"}}active{{end}}" href="/guru/dashboard" {{if eq .ActiveMenu "dashboard"}}aria-current="page"{{end}} title="Dashboard">
                <i class="bi bi-speedometer2"></i><span class="app-nav-label">Dashboard</span>
            </a>
        </li>
        <li>
            <a class="app-nav-link {{if eq .ActiveMenu "soal"}}active{{end}}" href="/guru/kelola-soal" {{if eq .ActiveMenu "soal"}}aria-current="page"{{end}} title="Kelola Soal">
                <i class="bi bi-question-square"></i><span class="app-nav-label">Kelola Soal</span>
            </a>
        </li>
        <li>
            <a class="app-nav-link {{if eq .ActiveMenu "essay"}}active{{end}}" href="/guru/essay" {{if eq .ActiveMenu "essay"}}aria-current="page"{{end}} title="Penilaian Essay">
                <i class="bi bi-pencil-square"></i><span class="app-nav-label">Penilaian Essay</span>
            </a>
        </li>
        <li>
            <a class="app-nav-link {{if eq .ActiveMenu "hasil"}}active{{end}}" href="/guru/hasil-siswa" {{if eq .ActiveMenu "hasil"}}aria-current="page"{{end}} title="Hasil Siswa">
                <i class="bi bi-trophy"></i><span class="app-nav-label">Hasil Siswa</span>
            </a>
        </li>
        <li>
            <a class="app-nav-link {{if eq .ActiveMenu "analisis"}}active{{end}}" href="/guru/analisis" {{if eq .ActiveMenu "analisis"}}aria-current="page"{{end}} title="Analisis">
                <i class="bi bi-bar-chart-line"></i><span class="app-nav-label">Analisis</span>
            </a>
        </li>
        <li>
            <a class="app-nav-link {{if eq .ActiveMenu "log"}}active{{end}}" href="/guru/log-kecurangan" {{if eq .ActiveMenu "log"}}aria-current="page"{{end}} title="Log Pelanggaran">
                <i class="bi bi-shield-exclamation"></i><span class="app-nav-label">Log Pelanggaran</span>
            </a>
        </li>
    </ul>

    <div class="app-sidebar-footer">
        <a class="app-nav-link {{if eq .ActiveMenu "akun"}}active{{end}}" href="/guru/akun" title="Akun saya">
            <i class="bi bi-person-circle"></i><span class="app-nav-label">{{if .NamaGuru}}{{.NamaGuru}}{{else}}{{.Username}}{{end}}</span>
        </a>
        <a class="app-nav-link" href="/logout-guru" data-confirm="Keluar dari panel guru?" title="Keluar">
            <i class="bi bi-box-arrow-right"></i><span class="app-nav-label">Keluar</span>
        </a>
    </div>
</aside>

<div class="app-backdrop" id="appBackdrop"></div>

<header class="app-topbar">
    <button class="app-topbar-toggle" type="button" id="appSidebarToggle" aria-controls="appSidebar" aria-label="Buka atau tutup menu">
        <i class="bi bi-list"></i>
    </button>
    <span class="fw-semibold text-truncate">MTs. AL-IHSAN BATUJAJAR</span>
    <a href="/logout-guru" class="btn btn-outline-secondary btn-sm ms-auto" data-confirm="Keluar dari panel guru?">
        <i class="bi bi-box-arrow-right me-1"></i><span class="d-none d-sm-inline">Keluar</span>
    </a>
</header>

{{template "app_sidebar_script"}}
{{end}}
