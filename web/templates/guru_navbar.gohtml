{{define "guru_navbar"}}
<nav class="navbar navbar-expand-lg navbar-dark bg-success sticky-top shadow-sm">
    <div class="container-fluid px-3">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/guru/dashboard">
            <img src="/images/logo-sekolah.png" alt="" width="30" height="30" class="d-inline-block">
            <span class="fw-bold">CBT Guru</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#guruNav" aria-controls="guruNav" aria-expanded="false" aria-label="Buka menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="guruNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link {{if eq .ActiveMenu "dashboard"}}active fw-semibold{{end}}" href="/guru/dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a></li>
                <li class="nav-item"><a class="nav-link {{if eq .ActiveMenu "soal"}}active fw-semibold{{end}}" href="/guru/kelola-soal"><i class="bi bi-question-square me-1"></i> Kelola Soal</a></li>
                <li class="nav-item"><a class="nav-link {{if eq .ActiveMenu "essay"}}active fw-semibold{{end}}" href="/guru/essay"><i class="bi bi-pencil-square me-1"></i> Penilaian Essay</a></li>
                <li class="nav-item"><a class="nav-link {{if eq .ActiveMenu "hasil"}}active fw-semibold{{end}}" href="/guru/hasil-siswa"><i class="bi bi-trophy me-1"></i> Hasil Siswa</a></li>
                <li class="nav-item"><a class="nav-link {{if eq .ActiveMenu "analisis"}}active fw-semibold{{end}}" href="/guru/analisis"><i class="bi bi-bar-chart-line me-1"></i> Analisis</a></li>
                <li class="nav-item"><a class="nav-link {{if eq .ActiveMenu "log"}}active fw-semibold{{end}}" href="/guru/log-kecurangan"><i class="bi bi-shield-exclamation me-1"></i> Log Pelanggaran</a></li>
            </ul>
            <div class="d-flex align-items-center gap-3">
                <span class="navbar-text text-light small"><a href="/guru/akun" class="text-light text-decoration-none" title="Akun saya"><i class="bi bi-person-circle me-1"></i>{{if .NamaGuru}}{{.NamaGuru}}{{else}}{{.Username}}{{end}}</a></span>
                <a href="/logout-guru" class="btn btn-outline-light btn-sm" data-confirm="Keluar dari panel guru?"><i class="bi bi-box-arrow-right me-1"></i> Keluar</a>
            </div>
        </div>
    </div>
</nav>
{{end}}
